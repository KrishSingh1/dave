    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Site",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/guess",
            "args": [
                "-input",
                "nc",
                "${input:site}.ins"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/benchmarks/ozflux/${input:site}",
            "osx": {
                "MIMode": "lldb"
            },
            "linux": {
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    },
                    {
                        "description":  "Set Disassembly Flavor to Intel",
                        "text": "-gdb-set disassembly-flavor intel",
                        "ignoreFailures": true
                    }
                ],
            },
            "windows": {
                "MIMode": "gdb"
            },
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "prepare-run",
        },
