        {
            "name": "Abisko",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/guess",
            "args": [
                "-input",
                "nc",
                "Abisko.ins"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/benchmarks/fluxnet/Abisko",
            "osx": {
                "MIMode": "lldb"
            },
            "linux": {
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    },
                    {
                        "description":  "Set Disassembly Flavor to Intel",
                        "text": "-gdb-set disassembly-flavor intel",
                        "ignoreFailures": true
                    }
                ],
            },
            "windows": {
                "program": "${workspaceFolder}/build/guesscmd.exe",
                "MIMode": "gdb"
            },
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "prepare-run",
        },
