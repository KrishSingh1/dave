{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build/*"
            ],
            "windows": {
                "args": [
                    "-r",
                    "-fo",
                    "build"
                ]
            },
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "problemMatcher": []
        },
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_CXX_STANDARD=14",
                "-DCMAKE_CXX_STANDARD_REQUIRED=ON",
                "-DCMAKE_CXX_EXTENSIONS=ON",
                "-B",
                "build"
            ],
            "windows": {
                "args": [
                    "-G",
                    "MinGW Makefiles",
                    "-DCMAKE_BUILD_TYPE=Debug",
                    "-DCMAKE_CXX_STANDARD=14",
                    "-DCMAKE_CXX_STANDARD_REQUIRED=ON",
                    "-DCMAKE_CXX_EXTENSIONS=ON",
                    "-B",
                    "build"
                ],
            },
            "options": {
                "cwd": "${workspaceRoot}",
                "env": {
                    "CMAKE_BUILD_TYPE": "Debug"
                }
            }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "linux": {
                "args": [
                    "--build",
                    "build",
                    "-j`nproc`"
                ]
            },
            "osx": {},
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "configure"
        },
        {
            "label": "update-output-path",
            "type": "shell",
            "command": "sed",
            "args": [
                "-i",
                "-r",
                "-e",
                "s/^([ \\t]*outputdirectory[ \\t]*\")[^\"]+(\".*)/\\1.\\/${input:outputdirectory}\\/\\2/gm",
                "${workspaceFolder}/benchmarks/ozflux/outputs.ins",
            ],
            "problemMatcher": [],
            "dependsOn": [
                "build",
                "test"
            ],
        },
        {
            "label": "create-output-directory",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/benchmarks/ozflux/${input:site}/${input:outputdirectory}"
            ]
        },
        {
            "label": "copy-ins-files",
            "type": "shell",
            "command": "cp",
            "args": [
                "${workspaceFolder}/benchmarks/ozflux/{,${input:site}/}*.ins",
                "${workspaceFolder}/benchmarks/ozflux/${input:site}/${input:outputdirectory}"
            ],
            "dependsOn": "create-output-directory"
        },
        {
            "label": "prepare-run",
            "problemMatcher": [],
            "dependsOn": [
                "build",
                // "update-output-path",
                // "copy-ins-files"
            ],
            "dependsOrder": "sequence"
        }
    ],
    "inputs": [
        {
            "id": "outputdirectory",
            "type": "promptString",
            "default": "out",
            "description": "Output dictory"
        },
        {
            "id": "site",
            "type": "command",
            "command": "extension.commandvariable.remember",
            "args": {
                "key": "sitename"
            }
        }
    ]
}
