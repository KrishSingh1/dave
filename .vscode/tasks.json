{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "*"
            ],
            "options": {
                "cwd": "${workspaceRoot}/build"
            }
        },
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                ".."
            ],
            "options": {
                "cwd": "${workspaceRoot}/build",
                "env": {
                    "CMAKE_BUILD_TYPE": "Debug"
                }
            },
            // "dependsOn": "clean"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "-j`nproc`"
            ],
            "options": {
                "cwd": "${workspaceRoot}/build",
                "env": {
                    "CMAKE_BUILD_TYPE": "Debug"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "configure"
        }
    ]
}
