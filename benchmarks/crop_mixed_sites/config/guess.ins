import "../../../data/ins/crop_n.ins"

param "file_gridlist" (str "gridlist.txt")

ifintercropgrass 1	! Whether to grow grass as cover crop between growing periods

!Landcover area fraction files
	param "file_lu"      (str "/scratch/johan/Benchmarks/Landuse_data/landuse_hurtt_1901_2006_mixed_sites_less_PNV.txt")
	param "file_lucrop"  (str "/scratch/johan/Benchmarks/Landuse_data/cropland_hurtt_mirca_1901_2006_mixed_sites_covercrops.txt")
	param "file_Nfert"   (str "/scratch/johan/Benchmarks/Landuse_data/n_fert_zaehle_1901_2006_mixed_sites.txt")
	
!Climate data and co2
	import "../../paths.ins"	

npatch 20             ! number of replicate patches to simulate

pft "CC3G_ic" (
	C3G
	landcover "cropland"
	laimax 4
	isintercropgrass 1
	harv_eff 0.0
	harv_eff_ic 0.0
	res_outtake 0.0			! not used by crop grass
	leaflong 1			! as in crop
)

pft "CC4G_ic" (
	C4G
	landcover "cropland"
	laimax 4
	isintercropgrass 1
	harv_eff 0.0
	harv_eff_ic 0.0
	res_outtake 0.0			! not used by crop grass
	leaflong 1			! as in crop
)

st "TeCoicc" (

	crop_stand
!	stinclude 1
	crop1 "TeCoi"
	hydrology1 "rainfed"
	intercrop "naturalgrass" 
)

st "TeWWcc" (

	crop_stand
!	stinclude 1
	crop1 "TeWW"
	hydrology1 "irrigated"
	intercrop "naturalgrass" 
)
