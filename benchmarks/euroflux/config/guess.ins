import "../../europe.ins"

ifcentury 1				! whether to use CENTURY SOM dynamics (mandatory for N cycling)
ifnlim 1				! whether plant growth limited by available N

file_speciesheights  "speciesheights.out"

! New Euroflux output files
file_eurofluxmonthly_nee        "eurofluxmonthly_nee.out"
file_eurofluxmonthly_aet        "eurofluxmonthly_aet.out"
file_eurofluxmonthly_gpp        "eurofluxmonthly_gpp.out"
file_eurofluxstats_nee          "eurofluxstats_nee.out"
file_eurofluxstats_aet          "eurofluxstats_aet.out"
file_eurofluxstats_gpp          "eurofluxstats_gpp.out"
file_eurofluxannual             "eurofluxannual.out"

! NB!!! To avoid inconsistencies, set ifrainonwetdaysonly = 0 when 
! adjusting precip data for the EUROFLUX comparisons
ifrainonwetdaysonly 0
