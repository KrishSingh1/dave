!///////////////////////////////////////////////////////////////////////////////////////
! Output files
!

! guess2008 - New predefined outputs. Procedure adapted from Ben's LPJ-GUESS Education
! outputdirectory is mandatory
outputdirectory "./"

! Prefined yearly output
! These files may be outcommented if their output is not required. 
file_cmass "cmass.out"
file_anpp "anpp.out"
file_lai "lai.out"
file_cflux "cflux.out"
file_dens "dens.out"
file_runoff "tot_runoff.out"
file_cpool "cpool.out"
file_firert "firert.out"

! Monthly outputs
file_mnpp "mnpp.out"
file_mlai "mlai.out"
file_mrh "mrh.out"
file_mgpp "mgpp.out"
file_mra "mra.out"
file_mnee "mnee.out"
file_maet "maet.out"
file_mpet "mpet.out"
file_mevap "mevap.out"
file_mintercep "mintercep.out"
file_mrunoff "mrunoff.out"
file_mwcont_upper "mwcont_upper.out"
file_mwcont_lower "mwcont_lower.out"
!///////////////////////////////////////////////////////////////////////////////////////



!///////////////////////////////////////////////////////////////////////////////////////
!// RUN PARAMETERS AND OPTIONS 
!

! Whether annual output desired (1) or not (0)
	param "annual_output" (num 1)

! Settings recognised by Plib
! Run GUESS with -help option for list of keywords and their meanings

title 'LPJ-GUESS (guess2008) cohort mode'

vegmode "cohort"      ! "cohort", "individual" or "population"
nyear_spinup 500      ! number of years to spin up the simulation for
ifdailynpp 1          ! whether to calculate NPP daily (1) or monthly (0)
ifdailydecomp 0       ! whether to calculate soil respiration daily (1) or monthly (0)
ifcalcsla 1           ! whether to calculate SLA from leaf longevity
                      ! (PFT-specific value can be specified in this file instead)
iffire 1              ! whether to implement fire (1) or not (0)
npatch 25             ! number of replicate patches to simulate
patcharea 1000        ! patch area (m2)
estinterval 5         ! years between establishment events in cohort mode
ifdisturb 1           ! whether generic patch-destroying disturbances enabled
distinterval 100      ! average return time for generic patch-destroying disturbances
					  ! guess2008 - 200 for Europe, 100 globally
ifbgestab 1           ! whether background establishment enabled
ifsme 1               ! whether spatial mass effect enabled
ifstochestab 1        ! whether establishment stochastic
ifstochmort 1         ! whether mortality stochastic
ifcdebt 1             ! whether to allow vegetation C storage (1) or not (0)


! guess2008 - additions
ifsmoothgreffmort 1				! whether to vary mort_greff smoothly with growth efficiency (1) 
								! or to use the standard step-function (0)
								! greff_min values below calibrated for the smooth (1) option 
ifdroughtlimitedestab 1			! whether establishment is limited by growing season drought
ifrainonwetdaysonly 1			! whether to rain on wet days only (1), or to rain a bit every day (0)
! guess2008 - eval - NB!!! To avoid inconsistencies, set ifrainonwetdaysonly = 0 when 
! adjusting precip data for the EUROFLUX comparisons
ifspeciesspecificwateruptake 1	! whether there is species specific water uptake (1) or not (0)
!///////////////////////////////////////////////////////////////////////////////////////



!///////////////////////////////////////////////////////////////////////////////////////
!// EVALUATION OPTIONS & SWITCHES 
!

param "emditest" (num 0)	! Whether to run the EMDI NPP test (1) or not (0)


!///////////////////////////////////////////////////////////////////////////////////////



!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings

group "common" (

	! Parameters common to all PFTs

	lambda_max 0.8
	emax 5
	reprfrac 0.1
	wscal_min 0.35
)

group "tree" (

	! Parameters common to all trees

	common
	lifeform "tree"
	crownarea_max 40	! PMxx: new default 27.3
	turnover_root 0.7	! PMxx: new default
	ltor_max 1
	k_allom2 40 
	k_allom3 0.67
	k_rp 1.6
	wooddens 200
	cton_leaf 29
	cton_root 29
	cton_sap 330
	pathway "c3"
	kest_repr 200
	kest_bg 0.1
	kest_pres 1
	litterme 0.3
	rootdist 0.6 0.4
)

group "Shrub"
(
	common
	lifeform "tree"
	crownarea_max 10
	turnover_root 0.7	! PMxx: new default
	ltor_max 1
	k_allom1 100
	k_allom2 5
	k_allom3 0.67
	k_rp 1.6
	wooddens 250
	cton_leaf 29
	cton_root 29
	cton_sap 330
	pathway "c3"
	kest_repr 20
	kest_bg 0.1
	kest_pres 1
	litterme 0.3
	rootdist 0.6 0.4
	longevity 100
)

group "needle_leaved"
(
	k_allom1 150
	k_latosa 4000		! PMxx: new default
)

group "broad_leaved"
(
	k_allom1 250 
	k_latosa 5000		! PMxx: new default
	leaflong 0.5		! PMxx: new default
    turnover_leaf 1		! PMxx: new default
)

group "grass" (

	! Parameters common to all grasses

	common
	lifeform "grass"
	ltor_max 0.5
	cton_leaf 29
	cton_root 29
	respcoeff 2.0 
	litterme 0.2
)

! greff_min values below calibrated for the smooth (ifsmoothgreffmort 1) option 
! From global version; values from orginal European version 
! (submitted LPJ-GUESS and Natura 2000) after "!"
group "shade_tolerant"
(
	est_max 0.05					
	parff_min 350000	! 1250000			
	alphar 3.0          			
	greff_min 0.04				
	turnover_sap 0.05
)


! So far only trial values; not in global version
group "intermediate_shade_tolerant"
(
	est_max 0.15					
	parff_min 2000000			
	alphar 7.0          			
	greff_min 0.06				
	turnover_sap 0.075 ! PMxx - bug! was 0.75
)


! From global version; values from orginal European version after "!"
group "shade_intolerant" 
(
	est_max 0.2					
	parff_min 2500000 
	alphar 10.0 
	greff_min 0.08		! 0.1
	turnover_sap 0.1	! 0.08 
)


group "boreal_tree"
(
	respcoeff 1.0
	pstemp_min -4
	pstemp_low 10
	pstemp_high 25
	pstemp_max 38
)

group "temperate_tree"
(
	respcoeff 1.0
	pstemp_min -2
	pstemp_low 15
	pstemp_high 25
	pstemp_max 38
)

pft "Abi_alb" (

	include 1
	tree
	shade_tolerant
	temperate_tree ! PMxx boreal_tree
	needle_leaved
	! k_latosa 3000 ! PMxx
	sla 9.3
	gmin 0.3
	phenology "evergreen"
	leaflong 3
	turnover_leaf 0.33
	! PMxx turnover_root 0.7
	phengdd5ramp 0
	tcmin_surv -2 ! GS -4.5 ! Sykes96: -4.5
	tcmin_est -2 ! GS 
	tcmax_est 2 ! GS 
	twmin_est 6 ! limit not implemented
	gdd5min_est 1600 ! GS ! Sykes96: 1450
	k_chilla 0
	k_chillb 100
	k_chillk 0.05
	fireresist 0.1
	intc 0.06
	longevity 350
	drought_tolerance 0.35 !0
)


pft "Aln_inc" (

    include 0 
    tree
    intermediate_shade_tolerant
    boreal_tree
    broad_leaved
    ! PMxx k_latosa 4000
    sla 24.3
    gmin 0.5
    phenology "summergreen"
    ! PMxx leaflong 0.5
    ! PMxx turnover_leaf 1
    ! PMxx turnover_root 0.7
    phengdd5ramp 200
    tcmin_surv -31
    tcmin_est -30
    tcmax_est -2.5  ! Sykes96
    twmin_est 5
    gdd5min_est 500	! Sykes96: 430
    k_chilla 0
    k_chillb 100 
    k_chillk 0.05 
    fireresist 0.2 ! was 0.1.see Tinner et al. 1999 (for Alnus glut.)
    intc 0.02
    longevity 200 ! Prentice & Helmisaari
    drought_tolerance 0.43 !0
)



pft "BES" (

	! boreal evergreen shrub

