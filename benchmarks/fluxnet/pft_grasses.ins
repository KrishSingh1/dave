!///////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings
!///////////////////////////////////////////////////////////////////////////////

! This file contains parameters specific to grasses and grass-only simulations

group "common" (
	! Parameters common to all PFTs

	! Landcover type in which this PFT can appear.
	landcover "natural"

	! Maximum evapotranspiration rate (mm/day).
	! Only used if using rootdist water uptake method.
	emax 10

	! Drought tolerance level (0 = very -> 1 = not at all) (unitless). Used to
	! implement drought-limited establishment. Also affects water uptake if
	! using species-specific water uptake. Small value ensures that this has
	! little effect even if ifdroughtlimitedestab is turned on.
	drought_tolerance 0.0001

	! Minimum mean winter monthly snow needed for establishment/survival (mm).
	! No restriction here.
	min_snow 0.0

	! Max annual GDD0 for establishment (℃ day). No restriction here.
	gdd0_max 100000

	! Min annual GDD0 for establishment (℃ day). No restriction here.
	gdd0_min 0

	! Maximum rate of drawdown on C storage for grasses, and N storage for both
	! grasses and trees (as fraction of pool size).
	max_mobil_cstorage 0.2

	! Photosynthesis parameters.

	! Cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma
	! et al. (2019)) (mol m-2 s-1).
	gcutic 0.0005

	! Stomatal intercept parameter (Medlyn et al. 2011) (mol m-2 s-1).
	g0 0.005

	! Stomatal slope parameter (Medlyn et al. 2011) (kPa^0.5). Used only for
	! forest-floor assimilation (elsewhere g1x is used). TODO: should we use g1x
	! for FF photosyn as well?
	g1 3.4

	! g1 at leaf water potential = -0.3 Mpa (Zhou et al. 2014).
	g1x 2

	! Activation energy for vcmax (kJ mol-1).
	ha_v 59.70

	! Activation energy for jmax (kJ mol-1)
	ha_j 40.71

	! Entropy term (deltaS) for vcmax (J mol-1 K-1).
	ds_v 639.43

	! Entropy term (deltaS) for jmax (J mol-1 K-1).
	ds_j 642.97

	! Nitrogen extinction coefficient within the canopy (Hikosaka et al. 2016).
	extkn 0.15

	! Sensitivity parameter indicating steepness of decline in Vcmax with water
	! stress (Zhou 2014 eqn 7). Only used when ifzhou = 1.
	s_f 1.0

	! Reference value at which Vcmax or Jmax is half it's non-water-stresed
	! value (Zhou 2014 eqn 7). Only used when ifzhou = 1.
	psi_f -2.0

	! The acclimation sensitivity coefficient for respiration (1/degC).
	! Placeholder value.
	racclim 1

	! Hydraulics parameters.

	! Maximum hydraulic conductance per unit xylem area (mol/m2/s/MPa).
	kmax 20

	! Water potential at which stomata close and roots disconnect from soil (MPa).
	stom_clos -1.5

	! Water potential at 50% loss of xylem conductance (MPa).
	p50 -3

	! Water potential at 88% loss of xylem conductance (MPa).
	p88 -4

	! Quantum yield of electron transport (mol (electrons) mol-1 (photon)).
	! Medlyn et al. 2002 (Plant, Cell and Environment).
	alpha 0.3

	! Fraction of PAR absorbed by the leaf area (0-1).
	absorptance_par 0.85

	! Fraction of NIR absorbed by the leaf area (0-1). Placeholder value.
	absorptance_nir 0.3

	! Leaf width (m).
	leaf_width 0.02

	! Reference temperature (°C) at which 50% damage occurs after 1 minute of
	! exposure.
	t50 55

	! Temperature sensitivity coefficient (°C). Controls how rapidly damage
	! changes with temperature; smaller values produce a steeper damage response
	! curve.
	z 5
)

group "tree" (

	! Parameters common to all trees

	common

	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 0

	! vcmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	vcmax_25 91.0

	! jmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	jmax_25 154.7

	! vpmax  at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	vpmax_25 100.0

	! Lifeform (tree, grass, or moss).
	lifeform "tree"

	! Maximum crown area (m2).
	crownarea_max 50

	! Fraction of NPP allocated to reproduction.
	reprfrac 0.02

	! Maximum leaf:root ratio under non-water-stressed conditions.
	ltor_max 1

	! Root turnover rate for trees (fraction of biomass turned over per year).
	turnover_root 0.7

	! Fraction of roots in each soil layer. Only used when rootdistribution is
	! set to "jackson".
	!rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04

	! Shape parameter for initialisation of root distribtion.
	root_beta 0.982

	! Constant in allometry equations.
	k_allom2 60

	! Constant in allometry equations.
	k_allom3 0.67

	! Constant in allometry equations.
	k_rp 1.6

	! Sapwood and heartwood density (kgC/m3).
	wooddens 200

	! Biochemical pathway for photosynthesis (C3 or C4).
	pathway "c3"

	! Maintenance respiration coefficient.
	respcoeff 1.0

	! Constant used in calculation of sapling establishment rate when spatial
	! mass effect enabled.
	kest_repr 200

	! Background recruitment rate (unitless). Only used when ifbgestab = 1.
	kest_bg 0.1

	! Recruitment rate  (unitless) used when spatial mass effect is disabled.
	kest_pres 1

	! Constant in equation for budburst chilling time requirement (Sykes et al
	! 1996). Only used if phengdd5ramp > 0.
	k_chilla 0

	! Coefficient in equation for budburst chilling time requirement. Only used
	! if phengdd5ramp > 0.
	k_chillb 100

	! Exponent in equation for budburst chilling time requirement. Only used if
	! phengdd5ramp > 0.
	k_chillk 0.05

	! Bole height as a fraction of tree height (0-1).
	boleht_frac 0.7

	! Annual turnover of grass seedbank (reproductive litter) to root litter as
	! a proportion of reproductive litter C biomass (patch-basis). This is
	! really about the grass seedbank, but trees do technically have a seedbank,
	! even if we decided not to use it for daily establishment in the same way
	! we did for grasses. Nonetheless, I'm leaving this parameter here as a
	! placeholder in case someone ever decides to play with this in the future.
	turnover_repr_litter 0.25

	! Annual turnover rate of live reproductive litter for trees as a fraction
	! of reproductive cmass.
	turnover_repr 0.5

	! 95% percentile NSC concentrations from eucface.

	! Maximum NSC concentration in leaves.
	max_leaf_nsc_conc  0.243

	! Maximum NSC concentration in wood.
	max_wood_nsc_conc  0.0797

	! Scalar for initial tree biomass.
	sapsize 0.1

	! Form factor to use in tree height calculations that takes into account the
	! relationship between the difference in tree mass between the cylindrical
	! stem hypothesis and measured mass of tree log with its branches.
	formfactor 1.0

	! Inflection point of sigmoidal carbon starvation as a function of storage
	! fraction full. Higher values mean carbon starvation starts at higher
	! storage levels.
	cstarv_inflect 0.1

	! Maximum fraction of cohort killed per year by carbon starvation mortality
	! when storage levels are low.
	! TODO: Check if this makes sense by comparing total mortality from C
	! starvation and greff.
	cstarv_max 0.3

	! Tree density at which carbon starvation mortality kills the entire cohort
	! (trees per m2).
	cstarv_killdens 0.001
)

group "shrub" (

	! Parameters common to all shrubs.

	common

	! Lifeform (tree, grass, or moss).
	lifeform "tree"

	! Leaf physiognomy (needleleaf, broadleaf).
	leafphysiognomy "broadleaf"

	! Biochemical pathway for photosynthesis (C3 or C4).
	pathway "c3"

	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 0

	! vcmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	vcmax_25 91.0

	! jmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	jmax_25 154.7

	! vpmax  at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0.
	vpmax_25 100.0

	! Maximum crown area (m2).
	crownarea_max 10

	! Maximum leaf:root ratio under non-water-stressed conditions.
	ltor_max 1

	! Constant in allometry equations.
	k_allom1 100

	! Constant in allometry equations.
	k_allom2 5

	! Constant in allometry equations.
	k_allom3 0.67

	! Constant in allometry equations.
	k_rp 1.6

	! Sapwood and heartwood density (kgC/m3).
	wooddens 250

	! Constant used in calculation of sapling establishment rate when spatial
	! mass effect enabled.
	kest_repr 200

	! Background recruitment rate (unitless). Only used when ifbgestab = 1.
	kest_bg 0.1

	! Recruitment rate  (unitless) used when spatial mass effect is disabled.
	kest_pres 1

	! Fraction of roots in each soil layer. Only used when rootdistribution is
	! set to "jackson".
	rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04

	! Shape parameter for initialisation of root distribtion.
	root_beta 0.982

	! Expected longevity under non-stressed conditions.
	longevity 100

	! Bole height as a fraction of tree height (0-1).
	boleht_frac 0
)



group "grass" (

	! Parameters common to all grasses

	common

	! Leaf physiognomy (needleleaf, broadleaf).
	leafphysiognomy "broadleaf"

	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 1

	! Maximum leaf:root ratio under non-water-stressed conditions.
	ltor_max 2.0

	! Fraction of roots in each soil layer. Only used when rootdistribution is
	! set to "jackson".
	!rootdist 0.18 0.18 0.18 0.18 0.18 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01

	! Shape parameter for initialisation of root distribtion.
	!root_beta 0.9555
	root_beta 0.96

	! Leaf phenology (raingreen, summergreen, evergreen, raingreen, summergreen,
	! cropgreen).
	phenology "any"

	! Annual turnover of grass seedbank (reproductive litter) to root litter as
	! a proportion of reproductive litter C biomass (patch-basis).
	turnover_repr_litter 0.2

	! Minimum forest-floor PAR for establishment (J/m2/day).
	parff_min 1000000

	! Interception coefficient (unitless).
	intc 0.01

	! Aerodynamic conductance (m s-1). Only used for VOCs.
	ga 0.030

	! Base water stress threshold below which dormancy is triggered. Units are wscal (0-1).
	wscal_min 0.4

	! Water stress threshold during dormancy and reproductive phase. Should be
	! >wscal_min (the base threshold). Units are wscal (0-1).
	wscal_min_dormant 0.6

	! Maintenance respiration coefficient.
	respcoeff 1.4

	! Turgor loss point (MPa). Only used with davehydraulics.
	tlp -1.0

	! Fraction of senesced carbon retranslocated back to storage.
	crelocfrac 0

	! Baseline senescence rate for dave grasses (d-1).
	senesc_base 0.00032

	! Senescence coefficient for dormancy in dave grasses. Senescence rate is
	! increased by this factor when phenology is changing at the maximum rate.
	senesc_scal_dorm 30

	! Senescence coefficient for water stress in dave grasses. Senescence rate
	! is increased by this factor under max water stress.
	senesc_scal_water 100

	! senescence coefficient for freezing temperatures.
	senesc_scal_temp 5
)

group "no_bioclimatic_limits" (

	! Remove all bioclimatic limits.

	! Minimum 20-year coldest month mean temperature for survival (℃).
  	tcmin_surv -1000

	! Minimum 20-year coldest month mean temperature for establishment (℃).
  	tcmin_est  -1000

	! Maximum 20-year coldest month mean temperature for establishment (℃).
  	tcmax_est   1000

	! Minimum warmest month mean temperature for establishment (℃).
  	twmin_est  -1000

	! Minimum degree day sum on 5 deg C base for establishment.
  	gdd5min_est 0
)




!///////////////////////////////////////////////////////////////////////////////
! Grass PFT parameters
!///////////////////////////////////////////////////////////////////////////////

group "C3G" (

	! Cool (C3) grass

	include 1

	! Inherited parameters.

	grass
	no_bioclimatic_limits

	! Biochemical pathway for photosynthesis (C3 or C4).
	pathway "c3"

	! Stomatal intercept parameter (Duursma et al. 2019) (mol m-2 s-1).
	g0 0.161

	! Stomatal slope parameter (Lin et al. 2015) (kPa^0.5).
	g1 4.5

	! Cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma
	! et al. (2019)) (mol m-2 s-1).
	gcutic 0.0012

	! Activation energy for growth temperature relationship (kJ mol-1)
	! (Parent & Tardieu 2012).
	Ha_growth 63.3

	! Parameter 'T0' in growth temperature relationship (K)
	! (Parent & Tardieu 2012).
	T0_growth 30.6

	! Parameter 'A' in growth temperature relationship (K-1)
	! (Parent & Tardieu 2012).
	A_growth 4.64411906e8

	! Temperature below which plants fall dormant (degC).
	temp_dormancy 5.0
)


group "perennial" (

	! Parameters common to all perennial grasses.

	! Lifeform (tree, grass, or moss).
	lifeform "grass_perennial"

	! Senescence coefficient for water stress in dave grasses. Senescence rate
	! is increased by this factor under max water stress.
	!senesc_scal_water 50

	! Senescence coefficient for reproductive phase in dave grasses.
	! Senescence rate is increased by this factor during reproductive phase.
	senesc_scal_repr 30

	! Exponent shaping development-driven senescence for dave grasses. Higher
	! values delay senescence (less early, more late in the reproductive
	! phase). Unitless.
	qdev_senesc 3

	! Exponent shaping water stress-driven senescence for DAVE grasses. q = 1
	! gives a linear response. q > 1 decreases senescence at low stress;
	! 0 < q < 1 increases it (not recommend). No effect at the extremes (wscal = 0 or 1).
	! Unitless.
	qwater_senesc 2.5
)

group "annual" (

	! Parameters common to all annual grasses.

	! Lifeform (tree, grass, or moss).
	lifeform "grass_annual"

	! Senescence coefficient for reproductive phase in dave grasses.
	! Senescence rate is increased by this factor during reproductive phase.
	senesc_scal_repr 120

	! Exponent shaping development-driven senescence for dave grasses. Higher
	! values delay senescence (less early, more late in the reproductive
	! phase). Unitless.
	qdev_senesc 35

	! Exponent shaping water stress-driven senescence for DAVE grasses. q = 1
	! gives a linear response. q > 1 increases senescence at moderate stress;
	! 0 < q < 1 reduces it. No effect at the extremes (wscal = 0 or 1).
	! Unitless.
	qwater_senesc 1
)

pft "C3G_perennial" (

	! Inherited parameters.

	C3G
	perennial

	include 1

	sla                35.0
    cton_leaf_min      13.7
	max_mobil_cstorage 0.2
	reprfrac           0.2
	crownfrac          0.2
	culmfrac           0.5
	extkn              0.17
)

pft "C3G_annual" (

	! Inherited parameters.

	C3G
	annual

	include 0

	! Specific leaf area (m2/kgC).
	sla                53.1

	! Minimum leaf C:N mass ratio.
	cton_leaf_min      13.7

	! Maximum NSC mobilisation rate from C storage (d-1).
	max_mobil_cstorage 0.7

	! Fraction of NPP allocated to reproduction.
	reprfrac           0.6

	! Fraction of NPP allocated to crowns.
	crownfrac          0.02

	! Fraction of shoot allocated to culms (=culm / (culm + leaves)).
	culmfrac           0.2

	! Nitrogen extinction coefficient within the canopy (Hikosaka et al. 2016).
	extkn              0.23
)

group "C4G" (

	! Warm (C4) grass

	include 0

	grass
	no_bioclimatic_limits

	! Biochemical pathway for photosynthesis (C3 or C4).
	pathway "c4"

	! Stomatal intercept parameter (Medlyn et al. 2011) (mol m-2 s-1).
	g0 0.049

	! Stomatal slope parameter (Medlyn et al. 2011) (kPa^0.5).
	g1 1.62

	! Cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma
	! et al. (2019)) (mol m-2 s-1).
	gcutic 0.0012

	! Activation energy for growth temperature relationship (kJ mol-1)
	! (Parent & Tardieu 2012).
	Ha_growth 60.6

	! Parameter 'T0' in growth temperature relationship (K)
	! (Parent & Tardieu 2012).
	T0_growth 37.3

	! Parameter 'A' in growth temperature relationship (K-1)
	! (Parent & Tardieu 2012).
	A_growth 9.3006791e7

	! Temperature below which plants fall dormant (degC).
	temp_dormancy 15.0
)

pft "C4G_perennial" (

	! Inherited parameters.

	C4G
	perennial

	include 1

	sla    	           35.0
	cton_leaf_min      17.1
    max_mobil_cstorage 0.2
	reprfrac           0.2
	crownfrac          0.2
	culmfrac           0.6
	extkn              0.17
)


pft "C4G_annual" (

	! Inherited parameters.
	C4G
	annual

	!include 0

	sla  	           53.1
	cton_leaf_min      17.1
	max_mobil_cstorage 0.7
	reprfrac           0.6
	crownfrac          0.02
	culmfrac           0.2
	extkn              0.23
)



! Key:
! sla:       Specific leaf area (m2/kgC).
! extkn:     Nitrogen extinction coefficient within the canopy (Hikosaka et al. 2016).
! culmfrac:  Fraction of shoot allocated to culms (=culm / (culm + leaves)).
! crownfrac: Fraction of NPP allocated to crowns.
! reprfrac: 
! max_mobil_cstorage: Maximum NSC mobilisation rate from C storage (d-1).
! cton_leaf_min: Minimum leaf C:N mass ratio.
