!///////////////////////////////////////////////////////////////////////////////////////
! Output files
!

! guess2008 - New predefined outputs. Procedure adapted from Ben's LPJ-GUESS Education
! outputdirectory is mandatory
outputdirectory "./"

! Prefined yearly output
! These files may be outcommented if their output is not required. 
file_cmass "cmass.out"
file_anpp "anpp.out"
file_lai "lai.out"
file_cflux "cflux.out"
file_dens "dens.out"
file_runoff "tot_runoff.out"
file_cpool "cpool.out"
file_firert "firert.out"
!file_age "age.out"
file_allometry "allometry.out"

! GUESSN
file_anppn "anppn.out"
file_cton "cton.out"
file_nmass "nmass.out"
file_nsources "nsources.out"
file_npool "npool.out"
file_nleach "nleach.out"
file_nuptake "nuptake.out"
file_vmaxnlim "vmaxnlim.out"

! Monthly outputs
file_mnpp "mnpp.out"
file_mlai "mlai.out"
file_mrh "mrh.out"
file_mgpp "mgpp.out"
file_mra "mra.out"
file_mnee "mnee.out"
file_maet "maet.out"
file_mpet "mpet.out"
file_mevap "mevap.out"
file_mintercep "mintercep.out"
file_mrunoff "mrunoff.out"
file_mwcont_upper "mwcont_upper.out"
file_mwcont_lower "mwcont_lower.out"

!file_dgpp "dgpp.out"
!///////////////////////////////////////////////////////////////////////////////////////



!///////////////////////////////////////////////////////////////////////////////////////
!// RUN PARAMETERS AND OPTIONS 
!

! Whether annual output desired (1) or not (0)
	param "annual_output" (num 1)

! Settings recognised by Plib
! Run GUESS with -help option for list of keywords and their meanings

title 'LPJ-GUESS (guess2008) cohort mode - global pfts'

vegmode "cohort"		! "cohort", "individual" or "population"
nyear_spinup 500		! number of years to spin up the simulation for
ifdailynpp 1			! whether to calculate NPP daily (1) or monthly (0)
						! guess2008 - species version has 1
ifdailydecomp 1			! whether to calculate soil respiration daily (1) or monthly (0)
ifcalcsla 1				! whether to calculate SLA from leaf longevity
						! (PFT-specific value can be specified in this file instead)
iffire 0				! whether to implement fire (1) or not (0)
npatch 1				! number of replicate patches to simulate
patcharea 1000			! patch area (m2)
estinterval 5			! years between establishment events in cohort mode
ifdisturb 1				! whether generic patch-destroying disturbances enabled
distinterval 100		! average return time for generic patch-destroying disturbances
						! guess2008 - 200 for Europe, 100 globally
ifbgestab 1				! whether background establishment enabled
ifsme 1					! whether spatial mass effect enabled
ifstochestab 1			! whether establishment stochastic
ifstochmort 1			! whether mortality stochastic
ifcdebt 1				! whether to allow vegetation C storage (1) or not (0)

!///////////////////////////////////////////////////////////////////////////////
! PROCESS SETTINGS SPECIFIC TO GUESSN
!///////////////////////////////////////////////////////////////////////////////

ifcentury 1				! whether to use CENTURY SOM dynamics (mandatory for N cycling)
ifnlim 1				! whether plant growth limited by available N
ifvarycn 1				! whether leaf and tissue C:N linearly scale with Vmax
ifnlimvarycn 1			! whether leaf and tissue C:N linearly scale with N limitation
iflimvmax 1			    ! whether Vmax limited by leaf N content
ifindiv_fnuptake 1		! whether to allow individual fractional N uptake
freenyears 50			! number of years to spin up without N limitation
ifdailysetntoc 1		! whether to use daily version of setntoc (set N:C ratio of som pools)
ifleachn 1				! whether to allow N leaching
ifnfix 1				! whether to include an estimate for N fixation (1=conservative,2=Central,3=Upper)
cwdtransfer 0.05		! fraction of woody debris transferred to SOM each year (0.05)
nmass_avail_max 0.002	! max N:C ratio in the soil (should be 0.002 (Parton et al 1993, Fig. 4))
nrelocfrac 0.5			! fraction of N retranslocated prior to leaf and root shedding
andep 0.0003			! default annual N deposition kgN/m2/yr (if file_andep not provided)
						! (pre-industrial N depostion 2 kgN/ha/year = 0.0002)
minndep 0.000008		! minimum allowed N deposition (usually pre-ind)
ifnstorage 1			! wheter to use a N storage for each individual  
ifndemand_new_est 1		! if new est has to compite for N

! end GUESSN

!FACE DAVID
FACE_ring 2				! To use average ambient or elevated CO2 at FACE sites (amb 1, ele 2) 
FACE_DUKE_or_OAK 1		! Which FACE site that will be examined (Oak 0, Duke 1)
Has_FACE_clim 0			! If we are using FACE clim data

!CANIF David
Has_CANIF_clim 0		! If we are using CANIF clim data

! guess2008 - additions
ifsmoothgreffmort 1				! whether to vary mort_greff smoothly with growth efficiency (1) 
								! or to use the standard step-function (0)  
								! greff_min values below calibrated for the smooth (1) option 
ifdroughtlimitedestab 0			! whether establishment is limited by growing season drought
								! guess2008 - species version has 1
ifrainonwetdaysonly 1			! whether to rain on wet days only (1), or to rain a bit every day (0)
ifspeciesspecificwateruptake 0	! whether there is species specific water uptake (1) or not (0)

!///////////////////////////////////////////////////////////////////////////////////////



!///////////////////////////////////////////////////////////////////////////////////////
!// EVALUATION OPTIONS & SWITCHES 
!

!///////////////////////////////////////////////////////////////////////////////////////





!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings

group "common" (

	! Parameters common to all PFTs

	lambda_max 0.8
	emax 5
	reprfrac 0.1
	wscal_min 0.35
	drought_tolerance 0.0001	
	! default value - ensures that this has little effect even if  
	! ifdroughtlimitedestab is turned on

)

group "tree" (

	! Parameters common to all trees

	common
	lifeform "tree"
	crownarea_max 50	
	ltor_max 1
	turnover_root 0.7
	rootdist 0.6 0.4	
	k_allom2 60		
	k_allom3 0.67
	k_rp 1.6
	wooddens 200
	pathway "c3"
	respcoeff 1.0	! utkommenterad hos Thomas !
	kest_repr 200 	! 200
	kest_bg 0.1 	! 1 i guess2008
	kest_pres 1 	! 0 i guess2008
	k_chilla 0
	k_chillb 100
	k_chillk 0.05
	litterme 0.3
)

group "Shrub"
(	
	! Unchanged from species version
	common
	lifeform "tree"
	crownarea_max 10
	ltor_max 1
	k_allom1 100
	k_allom2 5
	k_allom3 0.67
	k_rp 1.6
	wooddens 250
	pathway "c3"
	kest_repr 20
	kest_bg 0.1
	kest_pres 1
	litterme 0.3
	rootdist 0.6 0.4
	longevity 100
)


group "grass" (

	! Parameters common to all grasses

	common
	lifeform "grass"
	ltor_max 0.5
	rootdist 0.9 0.1  !Sitch et al give 0.9 0.1	Fraction of fine roots in the upper and lower soil layers.
	gmin 0.5
	phenology "any"
	phengdd5ramp 100		! C3 har 50 hos Thomas
	leaflong 1				! Leaf longevity (years)
	turnover_leaf 1
	turnover_root 0.7		! 0.5 hos guess2008
	cton_leaf_min 16
	cton_leaf_avr 25
	cton_leaf_max 45
	cton_root_avr 25 
	n_reserve 0.30
	litterme 0.2
	parff_min 1000000		! 2500000 i guess2008	
	fireresist 0.5			! 1.0 hos Thomas
	intc 0.01
)


group "broadleaved" (

	! Parameters common to all broadleaved trees

	k_allom1 250
	k_latosa 6000
	gmin 0.5
	intc 0.02
	cton_leaf_min 16
	cton_leaf_avr 25
	cton_leaf_max 45
	cton_root_avr 25 
	cton_sap_avr 172 !285 old value, new value from Friend 1997
)

group "needleleaved" (

	! Parameters common to all needleleaved trees

	k_allom1 150
	k_latosa 5000
	gmin 0.3
	intc 0.06
	cton_leaf_min 28
	cton_leaf_avr 42
	cton_leaf_max 75
	cton_root_avr 42 
	cton_sap_avr 290 !480 old value, new value from Friend 1997
)

group "evergreen" (

	! Parameters common to all evergreen trees

	phenology "evergreen"
	phengdd5ramp 0
	n_reserve 0.05
)

group "summergreen" (

	! Parameters common to all summergreen trees

	phenology "summergreen"
	phengdd5ramp 200
	leaflong 0.5
	turnover_leaf 1
	n_reserve 0.15
)

group "boreal" (

	! Parameters common to all boreal trees

	pstemp_min -4
	pstemp_low 10
	pstemp_high 25
	pstemp_max 38
	respcoeff 1.0
)

group "temperate" (

	! Parameters common to all temperate trees

	pstemp_min -2
	pstemp_low 15
	pstemp_high 25
	pstemp_max 38
	respcoeff 1.0
)

group "tropical" (

	! Parameters common to all tropical trees

	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000   ! no limit
	twmin_est -1000  ! no limit
	gdd5min_est 0    ! no limit
	pstemp_min 2
	pstemp_low 25
	pstemp_high 30
	pstemp_max 55
	respcoeff 0.15	!0.15	
)


! greff_min values below calibrated for the smooth (ifsmoothgreffmort 1) option 
group "shade_tolerant"
(
	est_max 0.05					
	parff_min 350000			
	alphar 3.0          			
	greff_min 0.04				
	turnover_sap 0.05
)

! So far only trial values; not used in this global version
group "intermediate_shade_tolerant"
(
	est_max 0.15					
	parff_min 2000000			
	alphar 7.0          			
	greff_min 0.06				
	turnover_sap 0.075
)

! From global version; values from orginal European version after "!"
group "shade_intolerant" 
(
	est_max 0.2					
	parff_min 2500000 
	alphar 10.0 
	greff_min 0.08
	turnover_sap 0.1
)



pft "BNE" (

	! Boreal needleleaved evergreen tree

	include 1
	tree
	needleleaved
	shade_tolerant
	evergreen
	boreal
	leaflong 3
	turnover_leaf 0.33
	tcmin_surv -31
	tcmin_est -30
	tcmax_est -1
	twmin_est 5
	gdd5min_est 500
	longevity 500
	fireresist 0.3
)


pft "BINE" (

	! Boreal needleleaved evergreen tree

	include 1
	tree
	needleleaved
	shade_intolerant
	evergreen
	boreal
	leaflong 3
	turnover_leaf 0.33
	tcmin_surv -31
	tcmin_est -30
	tcmax_est -1
	twmin_est 5
	gdd5min_est 500
	longevity 500
	fireresist 0.3
)


