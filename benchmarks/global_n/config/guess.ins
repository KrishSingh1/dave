!///////////////////////////////////////////////////////////////////////////////////////
! Forcing Data & gridlists - Windows
!

! Gridlist - path to file containing list of 0.5 x 0.5 degree grid cells to simulate
! You may need to specify the full pathname (including directory) here

	param "file_co2" (str "/data/benchmark_data/2010_11_22/co2/co2_1901-2006.txt")
      param "file_gridlist" (str "gridlist.txt")
	param "file_cru" (str "/data/benchmark_data/2010_11_22/cru/cru_1901_2006.bin")
	param "file_cru_misc" (str "/data/benchmark_data/2010_11_22/cru/cru_1901_2006misc.bin")

! N deposition (blank string to use constant value andep instead -- see below)
	param "file_ndep" (str "/home/joe/GlobalNdep.bin")
	!param "file_ndep" (str "")

!///////////////////////////////////////////////////////////////////////////////////////

! FACE
	
! DUKE
	!param "file_gridlist" (str "\home\david\data\FACE\gridlist_face_Duke.txt")
	param "met_face_duke" (str "\home\david\data\FACE\Daily_Duke_Met_data_96-07_Soenke.txt")
	param "ndep_face_duke" (str "\home\david\data\FACE\Yearly_Duke_N_dep_7.txt")
	!param "ndep_face_duke" (str "\home\david\data\FACE\Yearly_Duke_N_dep_13.7.txt")

! OAK
	!param "file_gridlist" (str "\home\david\data\FACE\gridlist_face_Oak.txt")
	param "met_face_oak" (str "\home\david\data\FACE\Daily_ORNL_Met_data_98-08_Soenke.txt")
	param "ndep_face_oak" (str "\home\david\data\FACE\Yearly_ORNL_N_dep.txt")

! CANIF files
	param "met_canif" (str "\home\david\data\CANIF\CANIF_met.txt") 

