########################################################################
# MAKESCRIPT
# Bash script to produce a portable script to submit and run LPJ-GUESS
# as a parallel job on Simba using Portable Batch System (PBS)
#
# Written by Ben Smith, Lund University, 2005-03-16
# revised 2006-03-03
#
# usage: sh makescript <guess-exe> <script file> [include script]
#
#

if [ $# == 3 ]; then
	source $3
fi

NPROCESS_DEFAULT=15
WALLTIME_DEFAULT=150:00:00
INSFILE_DEFAULT=guess.ins
GRIDLIST_DEFAULT=gridlist.txt
OUTFILES_DEFAULT='cmass.out firert.out anpp.out lai.out cflux.out dens.out tot_runoff.out mgpp.out mra.out mrh.out cpool.out mnpp.out mlai.out mnee.out maet.out mpet.out mevap.out mintercep.out mrunoff.out mwcont_upper.out mwcont_lower.out'

echo    '########################################################################' > $2
echo    '# '$2 >> $2
echo    '# Portable bash script to run LPJ-GUESS version:' >> $2
echo    '# '$PWD'/'$1 >> $2
echo    '# as a parallel job using PBS on Simba.' >> $2
echo    '#' >> $2
echo -n '# Created automatically on ' >> $2 ; date >> $2
echo    '# ' >> $2
echo    '# Usage: ' >> $2
echo    '#' >> $2
echo    '#   1. Copy script to the directory where you want output written.' >> $2
echo    '#      This will be called the RUN DIRECTORY.' >> $2
echo    '#   2. In an editor, set appropriate values for the variables NPROCESS,' >> $2
echo    '#      INSFILE, GRIDLIST and OUTFILES (NB: no space after the = sign):' >> $2
echo >> $2
echo    'NPROCESS='${NPROCESS:-$NPROCESS_DEFAULT} >> $2
echo    'WALLTIME='${WALLTIME:-$WALLTIME_DEFAULT} >> $2
echo    'INSFILE='${INSFILE:-$INSFILE_DEFAULT} >> $2
echo    'GRIDLIST='${GRIDLIST:-$GRIDLIST_DEFAULT} >> $2
echo    "OUTFILES='"${OUTFILES:-$OUTFILES_DEFAULT}"'" >> $2
echo >> $2
echo    '#      Where:' >> $2
echo    '#      NPROCESS = number of processes in parallel job' >> $2
echo    '#      WALLTIME = maximum wall (real) time for job hh:mm:ss' >> $2
echo    '#      INSFILE  = path to ins file from run directory' >> $2
echo    '#      GRIDLIST = path to gridlist file from run directory' >> $2
echo    '#      OUTFILES = list of LPJ-GUESS output files in single quotes,' >> $2
echo    '#                 and separated by spaces (filenames only, including' >> $2
echo    '#                 extension, no directory.)' >> $2
echo    '#' >> $2
echo    '#   3. Run the script using the command: sh '$2 >> $2
echo    '#' >> $2
echo    '# Nothing to change past here' >> $2
echo    '########################################################################' >> $2
echo >> $2
echo >> $2
echo    "echo \"##############################################################\" > progress.sh" >> $2
echo    "echo \"# PROGRESS.SH\" >> progress.sh" >> $2
echo    "echo \"# Upload current guess.log files from local nodes and check\" >> progress.sh" >> $2
echo    "echo \"# Usage: sh progress.sh\" >> progress.sh" >> $2
echo    "echo >> progress.sh" >> $2
echo >> $2
echo    '# Create a run subdirectory for each process and clean up' >> $2
echo >> $2
echo    'for ((a=1; a <= NPROCESS ; a++))' >> $2
echo    'do' >> $2
echo    '  mkdir run$a' >> $2
echo    '  cp $INSFILE run$a' >> $2
echo    '  cd run$a ; rm guess.log ; rm gridlist.txt ; cd ..' >> $2

echo    "  echo \"echo '********** Last few lines of ./run"'${a}'"/guess.log: **********'\" >> progress.sh" >> $2
echo    "  echo \"tail ./run"'${a}'"/guess.log\" >> progress.sh" >> $2

echo    'done' >> $2
echo >> $2
echo    '# Create PBS script to request place in queue' >> $2
echo >> $2
echo    "echo '#/bin/sh' > guess.cmd" >> $2
echo    "echo '#PBS -l nodes='"'$NPROCESS'" >> guess.cmd" >> $2
echo    "echo '#PBS -l walltime='"'$WALLTIME'" >> guess.cmd" >> $2
echo    "echo 'export PGI=/usr/local/pgi' >> guess.cmd" >> $2
echo    "echo 'export PATH=$PGI/linux86-64/6.0/bin:''$''PATH' >> guess.cmd" >> $2
echo    "echo 'cd '"'$PWD'" >> guess.cmd" >> $2
echo    "echo 'ln -f -s "$PWD"/"$1" guessexe' >> guess.cmd" >> $2
echo    "echo 'mpiexec -comm mpich-p4 -n '"'$NPROCESS'"' guessexe '"'$INSFILE'" "'$GRIDLIST'" "'$OUTFILES'"' > stdout.log' >> guess.cmd" >> $2
echo >> $2
echo    '# Submit job' >> $2
echo    'qsub -N ${1:-"guess"} guess.cmd' >> $2

