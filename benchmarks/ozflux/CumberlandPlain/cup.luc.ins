! Cumberland Plain landcover / stand-initialisation test configuration.
!
! This file is imported by CumberlandPlain.ins after the shared ozflux
! settings and landcover defaults.

!///////////////////////////////////////////////////////////////////////////////
! Input files
!///////////////////////////////////////////////////////////////////////////////

! Annual landcover fractions by broad landcover type. Columns are landcover
! names such as NATURAL and FOREST; values should normally sum to one.
! These fractions define the target area of each landcover class each year.

param "file_lu"                          (str "cup.luc.txt")

! Gross stand-type transitions. Columns are named FROM_TO, for example
! Natural_Forest or Forest_Natural. This tells the model which stand type
! loses area and which stand type gains it when fractions change.
! Use this for explicit test cases; it is less ambiguous than grossLUC.
param "file_grossSTC"                    (str "cup.gross_stc.txt")

! Alternative gross landcover transition input. Leave empty when using
! file_grossSTC. grossLUC works at landcover level rather than stand-type
! level and is mostly useful for LUH-style landcover transition inputs.
param "file_grossLUC"                    (str "")

! Prescribed disturbance inputs.
param "file_dist_clearcut"               (str "")
param "file_dist_fire"                   (str "")
param "file_dist_wind"                   (str "")
param "file_dist_barkbeetle"             (str "")
param "file_storm_prob"                  (str "")

! Managed-forest harvest probability/intensity inputs. Empty means no external
! probabilistic harvest regime. The local Forest management types below also
! suppress disturbance/fire to keep this test focused on LUC and init.
param "file_woodharv_prob_BL"            (str "")
param "file_woodharv_prob_NL"            (str "")
param "file_CC_prob_BL"                  (str "")
param "file_CC_prob_NL"                  (str "")
param "file_woodharv_intens_mean_BL"     (str "")
param "file_woodharv_intens_mean_NL"     (str "")
param "file_woodharv_intens_sd_BL"       (str "")
param "file_woodharv_intens_sd_NL"       (str "")
param "file_woodharv_size_preference_BL" (str "")
param "file_woodharv_size_preference_NL" (str "")
param "file_woodharv_intensity_scalar"   (str "")

param "file_presc_burned_area"           (str "")

!param "file_Nfert_st"            (str "")
!param "file_cutinterval_st"      (str "")
!param "file_firstmanageyear_st"  (str "")

!///////////////////////////////////////////////////////////////////////////////////////
! Landcover switches
!///////////////////////////////////////////////////////////////////////////////////////

! Enable dynamic landcover fractions and stand-type transitions.
run_landcover 1

! Active landcover classes in this test. Natural and managed forest are enabled;
! crops, pasture, urban, peatland, and barren are left out to keep the test small.
run_natural 1
run_forest 1
run_crop 0
run_pasture 0
run_urban 0
run_peatland 0
run_barren 0

!///////////////////////////////////////////////////////////////////////////////////////
! Landcover transfer / stand creation
!///////////////////////////////////////////////////////////////////////////////////////

! Secondary/new stands use npatch_secondarystand from landcover.ins.
! Uncomment locally if you want to override the shared value.
! npatch_secondarystand 1

! Controls which existing stands lose area when a stand type contracts.
! reduce_all_stands 0 keeps the default age/priority logic; age_limit_reduce
! protects very young stands from being reduced unless the algorithm must use
! them.
!reduce_all_stands 0
!age_limit_reduce 15

! Pooling level for transitions:
!   0 = one pooled transfer bucket
!   1 = landcover-level transfer buckets
!   2 = stand-type-level transfer buckets
! Stand-type level is useful here because grossSTC says exactly which stand
! type donates/receives area.
transfer_level 2

! Create new runtime stands during transfers according to copy_stand_type().
iftransfer_to_new_stand 1

! Treat natural-to-forest conversion as harvested when appropriate, rather than
! silently moving biomass. Useful for testing biomass transfer/accounting.
harvest_natural_to_forest 1

!///////////////////////////////////////////////////////////////////////////////////////
! Output files
!///////////////////////////////////////////////////////////////////////////////////////

! Change this to redirect outputs if you want to avoid polluting the default
! output directory.
outputdirectory "./out/"

printseparatestands 1
printstandtypes 1

file_forest_cflux_veg "forest_cflux_veg.out"
file_forest_vegc "forest_vegc.out"
file_forest_harvest "forest_harvest.out"
file_harvest_flux_luc "harvest_flux_luc.out"

file_cflux_natural "cflux_natural.out"
file_cflux_forest "cflux_forest.out"
file_cpool_natural "cpool_natural.out"
file_cpool_forest "cpool_forest.out"

file_cmass_sts "cmass_sts.out"
file_cmass_wood_sts "cmass_wood_sts.out"
file_clitter_sts "clitter_sts.out"
file_csoil_sts "csoil_sts.out"
file_luc_cflux_sts "luc_cflux_sts.out"
file_frac_sts "frac_sts.out"
file_nstand_sts "nstand_sts.out"

!///////////////////////////////////////////////////////////////////////////////////////
! Management types
!///////////////////////////////////////////////////////////////////////////////////////

! A management type ("mt") is a named management regime. A stand type can list
! up to three regimes with management1, management2, and management3, and the
! runtime stand can switch between them during management/rotation logic.
!
! Forest_init is the first regime for the Forest stand type. It is the regime
! active when prescribed tree initialisation is applied.
mt "Forest_init" (

    ! Continuous harvest system is a low-key default used by the forestry code.
    ! With the harvest input files empty and cutfirstyear 0, it should not
    ! introduce active cutting in this test.
    harvest_system "continuous"

    ! Keep stochastic/natural fire and disturbance from confounding the
    ! landcover and prescribed-initialisation accounting tests.
    suppress_fire 1
    suppress_disturbance 1

    ! 0 = do not cut trees immediately when this management type starts.
    ! 1 = create/reconcile as a new cleared stand rather than cloning trees
    ! 2 = clone donor stand, then kill/harvest trees immediately
    cutfirstyear 0

    ! Optional planting/regeneration regime for managed forests.
    ! "selection" means only PFTs listed in selection are deliberately planted;
    ! reestab controls whether natural tree re-establishment is allowed later.
    !
    ! planting_system "selection"
    ! selection "MRS"

    ! None means no natural establishment can occur.
    ! Restricted means only the selected PFTs can establish naturally.
    ! All means any natural tree PFT can establish naturally.
    ! reestab "restricted"       ! "none", "restricted", or "all"

    ! Use explicit densities with planting()
    ! set_planting_density 1

    ! seedlings/ha, one value per selected PFT
    ! plantdensity "1000"

    ! Bypass normal establishment filters for planting
    ! relaxed_establishment 1

    ! Cut unselected tree PFTs on clone/rotation year
    ! cutfirstyear_unsel 1

    ! Remove grasses during clearcut
    ! killgrass_at_cc 1
)

! Forest_postinit exists so prescribed establishment can move the stand into a
! second management regime after initialisation. Keep a second mt while testing
! establish_input_gridcell(), because that path currently expects one.
mt "Forest_postinit" (
    harvest_system "continuous"
    suppress_fire 1
    suppress_disturbance 1
    cutfirstyear 0
)

!///////////////////////////////////////////////////////////////////////////////////////
! Stand types
!///////////////////////////////////////////////////////////////////////////////////////

! A stand type ("st") is a template. At runtime LPJ-GUESS creates, clones,
! shrinks, expands, and deletes stand instances based on the landcover inputs.
! Multiple runtime stands may share this same stand type.
st "Forest" (

    ! Common defaults from landcover.ins.
    common_stand

    ! Include this stand type in the simulation.
    stinclude 1

    ! Landcover type for this stand type.
    landcover "forest"

    ! Allow natural PFTs as well as forest PFTs. This is useful in here
    ! because MRS is currently a natural tree PFT, while this stand is FOREST.
    naturalveg "all"

    ! Management regimes. management1 is active initially; management2 is used
    ! by prescribed establishment when moving out of the init regime.
    management1 "Forest_init"
    management2 "Forest_postinit"
    ! management3 "AnotherForestRegime"

    ! Prescribed tree/cohort initialisation input. Shape:
    ! Lon Lat Tree_no init_year str_pft biomass dbh dens tree_age
    ! This is separate from natural establishment and management planting.
    file_treeinit_st "cup.treeinit.txt"

    ! time-varying target PFT fractions
    ! file_targetfrac_pft_mt "targetfrac.txt"

    ! force first management in this year
    ! firstmanageyear 1950
)
