!///////////////////////////////////////////////////////////////////////////////
! C4 grass PFT settings
!///////////////////////////////////////////////////////////////////////////////

group "C4G" (

	! Warm (C4) grass

	include 1
	grass
	pathway "c4"
	g0 0.049
	g1 1.62
	gmin 0.0012 
	respcoeff 1.0
	pstemp_min 6
	pstemp_low 20
	pstemp_high 45
	pstemp_max 55
	Ha_growth 60.6
	T0_growth 37.3
	A_growth 9.3006791e7
	tcmin_surv -1000    ! no limit
	tcmin_est -1000     ! no limit
	tcmax_est 1000		! no limit
	twmin_est -1000		! no limit
	gdd5min_est 0		! no limit
	temp_dormancy 15.0
	eps_iso 8.0
	seas_iso 0
	eps_mon 0.48 0.19 0.67 0.14 0.12 0.13 0.14 0.29 0.24
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5
	harv_eff 0.5
)

!pft "C4G_perennial" (

!	C4G

!	lifeform "grass_perennial"
!	sla    	      35.0
!	cton_leaf_min 17.1
!	RGR_pot       0.2
!	reprfrac      0.2
!	crownfrac     0.2
!	culmfrac      0.5
!	extkn         0.17
!)


pft "C4G_annual" (

   C4G
	
   lifeform "grass_annual"
   sla  	     53.1
   cton_leaf_min 17.1
   RGR_pot       0.3
   reprfrac      0.6
   crownfrac     0.02
   culmfrac      0.2
   extkn         0.23
)
