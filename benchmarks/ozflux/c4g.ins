!///////////////////////////////////////////////////////////////////////////////
! C4 grass PFT settings
!///////////////////////////////////////////////////////////////////////////////

group "C4G" (

	! Warm (C4) grass

	include 1
	grass
	pathway "c4"
	g0 0.005
	g1 1.62
	respcoeff 0.15
	pstemp_min 6
	pstemp_low 20
	pstemp_high 45
	pstemp_max 55
	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000		! no limit
	twmin_est -1000		! no limit
	gdd5min_est 0		! no limit
	eps_iso 8.0
	seas_iso 0
	eps_mon 0.48 0.19 0.67 0.14 0.12 0.13 0.14 0.29 0.24
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5
	harv_eff 0.5
)

pft "C4G_perennial" (

	C4G

	lifeform "grass_perennial"
	reprfrac  0.05
	crownfrac 0.2
	culmfrac  0.4
)


!pft "C4G_annual" (

!	C4G
	
!	lifeform "grass_annual"
!	reprfrac  0.40
!	crownfrac 0.01
!   culmfrac 0.2
!)
