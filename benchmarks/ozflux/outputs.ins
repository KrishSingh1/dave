!///////////////////////////////////////////////////////////////////////////////////////
! Output files
!///////////////////////////////////////////////////////////////////////////////////////

! outputdirectory is mandatory. Should be "./" for parallel runs.
outputdirectory "./out/"
ifdailyoutput 1

! Annual gridcell-level outputs.
file_aagb                          "aagb.out"                          ! Annual gridcell-level above-ground biomass (kg/m2)
!file_aagb_tree                     "aagb_tree.out"                     ! Annual gridcell-level above-ground tree biomass (kg/m2)
!file_dave_amet_prec                "dave_amet_prec.out"                ! Annual gridcell-level precipitation (mm)
!file_dave_amet_par                 "dave_amet_par.out"                 ! Annual gridcell-level PAR (J/m2)
!file_dave_lai_ymax                 "dave_lai_ymax.out"                 ! Maximum gridcell-level annual leaf area index (m2/m2)
!file_dave_agb_ymax                 "dave_agb_ymax.out"                 ! Maximum gridcell-level annual above-ground biomass (kg/m2)
!file_dave_lai_ymean                "dave_lai_ymean.out"                ! Mean gridcell-level annual leaf area index (m2/m2)
!file_dave_agb_ymean                "dave_agb_ymean.out"                ! Mean gridcell-level annual above-ground biomass (kg/m2)

! Annual patch-level outputs.
!file_dave_patch_age                "dave_patch_age.out"                ! Annual patch-level age since last disturbance (years)
!file_dave_arunoff                  "dave_arunoff.out"                  ! Annual runoff (mm)
!file_dave_acpool                   "dave_acpool.out"                   ! Annual C pools (kgC/m2)
!file_dave_anpool                   "dave_anpool.out"                   ! Annual N pools (kgN/m2)
!file_dave_acflux                   "dave_acflux.out"                   ! Annual C flux (gC/m2)
!file_dave_anflux                   "dave_anflux.out"                   ! Annual N fluxes (kgN/m2/year)
!file_dave_globfirm                 "dave_globfirm.out"                 ! Annual GLOBFIRM output file
!file_dave_mwcont_upper             "dave_mwcont_upper.out"             ! Monthly wcont_upper output file (0-1)
!file_dave_mwcont_lower             "dave_mwcont_lower.out"             ! Monthly wcont_lower output file (0-1)
!file_dave_apet                     "dave_apet.out"                     ! Annual potential patch-level evapotranspiration (mm)
!file_dave_asimfire                 "dave_asimfire.out"                 ! Annual simfire analysis
!file_dave_afuel                    "dave_afuel.out"                    ! Annual blaze fuel availability (gC/m2)
!file_dave_acoarse_woody_debris     "dave_acoarse_woody_debris.out"     ! Annual coarse woody debris (gC/m2)
!file_dave_amet_year                "dave_amet_year.out"                ! Current year of met data being used
!file_dave_aco2                     "dave_aco2.out"                     ! Annual atmospheric co2 concentration (ppm)
!file_dave_aminleach                "dave_aminleach.out"                ! Annual leaching rate (kgN/m2/yr)
!file_dave_sompool_acmass           "dave_sompool_acmass.out"           ! Daily SOM pool C mass (kgC/m2)
!file_dave_sompool_anmass           "dave_sompool_anmass.out"           ! Daily SOM pool N mass (kgN/m2)
!file_dave_fpar_ff                  "dave_fpar_ff.out"                  ! Daily forest floor fpar (0-1)
!file_dave_andep                    "dave_andep.out"                    ! Annual nitrogen deposition (kgN/m2)
!file_dave_resp_heterotrophic       "dave_resp_heterotrophic.out"       ! Daily carbon flux to atmosphere from soil respiration (gC/m2/day)
!file_dave_anfixation               "dave_anfixation.out"               ! Total annual biological N fixation (kgN/m2/year)
!file_dave_water_budget_annual      "dave_water_budget_annual.out"      ! Annual water budget (mm)
!file_dave_nitrogen_budget_annual   "dave_nitrogen_budget_annual.out"   ! Annual nitrogen budget (kgN/m2)
!file_dave_par_grass                "dave_par_grass.out"                ! Annual mean PAR at top of grass canopy (MJ/m2/year)

! Annual indiv-level per-patch outputs.
file_dave_alai                     "dave_alai.out"                     ! Annual LAI(m2/m2)
!file_dave_afpc                     "dave_afpc.out"                     ! Annual FPC ()
!file_dave_acmass                   "dave_acmass.out"                   ! Annual cmass (kgC/m2). Unlike the "standard" cmass output file, this is an individual-level output; it does not contain litter, and it will not account for individuals which were established and died in the same year.
!file_dave_anmass                   "dave_anmass.out"                   ! Annual nmass (kgN/m2). Unlike the "standard" nmass output file, this is an individual-level output; it does not contain litter, and it will not account for individuals which were established and died in the same year.
!file_dave_aheight                  "dave_aheight.out"                  ! Annual plant height (m)
!file_dave_altor                    "dave_altor.out"                    ! Leaf to root carbon allocation ratio
!file_dave_aaet                     "dave_aaet.out"                     ! Annual actual evapotranspiration (mm)
!file_dave_adensity                 "dave_adensity.out"                 ! Annual density of individuals over patch (/m2)
!file_dave_altor                    "dave_altor.out"                    ! Annual leaf to root ration (unitless)
!file_dave_anuptake                 "dave_anuptake.out"                 ! Total annual nitrogen uptake (kgN/m2/year)
!file_dave_a_aboveground_cmass      "dave_a_aboveground_cmass.out"      ! Annual above-ground C biomass (kgC/m2)
!file_dave_a_belowground_cmass      "dave_a_belowground_cmass.out"      ! Annual below-ground C biomass (kgC/m2)
!file_dave_a_aboveground_nmass      "dave_a_aboveground_nmass.out"      ! Annual above-ground N biomass (kgN/m2)
!file_dave_a_belowground_nmass      "dave_a_belowground_nmass.out"      ! Annual below-ground N biomass (kgN/m2)
!file_dave_aresponse_window         "dave_aresponse_window.out"         ! Annual output of response window length (days)
!file_dave_anretranslocated         "dave_anretranslocated.out"         ! Annual nitrogen retranslocated (kgN/m2)
!file_dave_amort_greff              "dave_amort_greff.out"              ! Annual PFT-level growth-efficiency-related mortality, expressed as fraction of individuals within the cohort which died this year, summed across all indivs of a given PFT.
!file_dave_amort_age                "dave_amort_age.out"                ! Annual PFT-level age-related mortality, expressed as fraction of individuals within the cohort which died this year, summed across all indivs of a given PFT.
!file_dave_acmass_germ              "dave_acmass_germ.out"              ! Annual germinated C mass (kgC/m2)

! Annual pft-level per-patch outputs.
!file_dave_anpp                     "dave_anpp.out"                     ! Total Annual Pft-Level NPP (kgC/m2/year)
!file_dave_agpp                     "dave_agpp.out"                     ! Total Annual Pft-Level GPP (kgC/m2/year)
!file_dave_acue                     "dave_acue.out"                     ! Annual CUE (unitless)
!file_dave_aresp                    "dave_aresp.out"                    ! Total Annual Pft-Level Autotrophic Respiration (kgC/m2/year)
!file_dave_anee                     "dave_anee.out"                     ! Total annual patch-level NEE (kgC/m2)
!file_dave_acmass_mort              "dave_acmass_mort.out"              ! Mass of annual killed vegetation (kgC/m2/year)
!file_dave_aclitter                 "dave_aclitter.out"                 ! Total End-of-Year PFT-Level C Mass in Litter (kgC/m2)
!file_dave_ancohort                 "dave_ancohort.out"                 ! Number of cohorts currently established per pft (unitless)
!file_dave_anetps_ff                "dave_anetps_ff.out"                ! Annual net photosynthesis at forest floor (kgC/m2)
!file_dave_ansapling                "dave_ansapling.out"                ! Number of saplings of each PFT ready to establish (trees only)
!file_dave_ansapling_year           "dave_ansapling_year.out"           ! Recruitment rate of each PFT (saplings per year) (trees only)
!file_dave_cton_leaf_max            "dave_cton_leaf_max.out"            ! Maximum C:N ratio of leaves (unitless)
!file_dave_cton_leaf_min            "dave_cton_leaf_min.out"            ! Maximum C:N ratio of leaves (unitless)
!file_dave_cton_root_max            "dave_cton_root_max.out"            ! Maximum C:N ratio of leaves (unitless)
!file_dave_cton_root_min            "dave_cton_root_min.out"            ! Maximum C:N ratio of leaves (unitless)
!file_dave_cton_sap_max             "dave_cton_sap_max.out"             ! Maximum C:N ratio of leaves (unitless)
!file_dave_cton_sap_min             "dave_cton_sap_min.out"             ! Maximum C:N ratio of leaves (unitless)

! Annual stand-level outputs.
!file_dave_stand_frac               "dave_stand_frac.out"               ! Fraction of the gridcell occupied by each stand.
!file_dave_stand_type               "dave_stand_type.out"               ! Stand landcover types

! Annual stand-level pft outputs.
!file_dave_anetps_ff_max            "dave_anetps_ff_max.out"            ! Annual net photosynthesis at forest floor (kgC/m2)
!file_dave_spft_cmass_repr          "dave_spft_cmass_repr.out"          ! Daily reproductive cmass at standpft-level (gC/m2)

! Annual per-patch aggregated individual-level outputs.
!file_dave_acalloc_leaf             "dave_calloc_leaf.out"              ! Total annual C allocation to leaf (kgC/m2)
!file_dave_acalloc_root             "dave_calloc_root.out"              ! Total annual C allocation to root (kgC/m2)
!file_dave_acalloc_repr             "dave_calloc_repr.out"              ! Total annual C allocation to repr (kgC/m2)
!file_dave_acalloc_sap              "dave_calloc_sap.out"               ! Total annual C allocation to sap (kgC/m2)
!file_dave_acalloc_storage          "dave_calloc_storage.out"           ! Total annual C allocation to sap (kgC/m2)
!file_dave_acalloc_crown            "dave_acalloc_crown.out"            ! Total annual C allocation to crown (kgC/m2)
!file_dave_anstorage_drawdown       "dave_anstorage_drawdown.out"       ! Total annual amount of N withdrawn from storage for growth (kgN/m2)

! Annual indiv-level outputs.
!file_dave_indiv_mort               "dave_indiv_mort.out"               ! Annual indiv-level mortality divided by component/cause, expressed as fraction of individuals within the cohort which died this year.
!file_dave_indiv_age                "dave_indiv_age.out"                ! Individual-level age (years)

! Daily gridcell-level outputs.
file_agb                            "agb.out"                           ! Daily gridcell-level above-ground biomass (kg/m2)
file_agb_tree                       "agb_tree.out"                      ! Daily gridcell-level above-ground tree biomass (kg/m2)

! Daily pft-level per-patch outputs.
file_dave_lai                      "dave_lai.out"                      ! LAI by individual (m2/m2)
!file_dave_meanleafage              "dave_meanleafage.out"              ! Mean leaf age (years)
!file_dave_meansapage               "dave_meansapage.out"               ! Mean sapwood age (years)
!file_dave_meanrootage              "dave_meanrootage.out"              ! Mean root age (years)
!file_dave_sla                      "dave_sla.out"                      ! SLA by individual (m2/kgC)
!file_dave_cmass_crown              "dave_cmass_crown.out"              ! Crown C mass (kgC/m2)
!file_dave_cmass_leaf               "dave_cmass_leaf.out"               ! Leaf C mass (kgC/m2)
!file_dave_cmass_leaf_brown         "dave_cmass_leaf_brown.out"         ! Brown Leaf C mass (kgC/m2)
!file_dave_nmass_leaf               "dave_nmass_leaf.out"               ! Leaf N mass (kgN/m2)
!file_dave_cmass_root               "dave_cmass_root.out"               ! Root C mass (kgC/m2)
!file_dave_nmass_root               "dave_nmass_root.out"               ! Root N mass (kgN/m2)
!file_dave_nmass_crown               "dave_nmass_crown.out"              ! Crown N mass (kgN/m2)
!file_dave_cmass_repr               "dave_cmass_repr.out"               ! Reproductive C mass (kgC/m2)
!file_dave_nmass_repr               "dave_nmass_repr.out"               ! Reproductive N mass (kgN/m2)
!file_dave_cmass_sap                "dave_cmass_sap.out"                ! Sapwood C mass (kgC/m2)
!file_dave_cton_sap                 "dave_cton_sap.out"                 ! Sapwood C to N ratio (kgC/kgN)
!file_dave_cton_leaf                "dave_cton_leaf.out"                ! Leaf C to N ratio (kgC/kgN)
!file_dave_cton_root                "dave_cton_root.out"                ! Root C to N ratio (kgC/kgN)
!file_dave_cton_heart               "dave_cton_heart.out"               ! Heartwood C to N ratio (kgC/kgN)
!file_dave_cton_storage             "dave_cton_storage.out"             ! Storage C to N ratio (kgC/kgN)
!file_dave_cton_crown               "dave_cton_crown.out"               ! Crown C to N ratio (kgC/kgN)
!file_dave_cmass_heart              "dave_cmass_heart.out"              ! Heartwood C mass (kgC/m2)
!file_dave_cmass                    "dave_cmass.out"                    ! Total C biomass per individual per patch (kgC/m2)
!file_dave_nmass                    "dave_nmass.out"                    ! Total N biomass per individual per patch (kgN/m2)
!file_dave_cmass_storage            "dave_cmass_storage.out"            ! C storage per individual (kgC/m2)
!file_dave_cmass_storage_max        "dave_cmass_storage_max.out"        ! C storage capacity per individual (kgC/m2)
!file_dave_nmass_storage            "dave_nmass_storage.out"            ! N storage per individual (kgN/m2)
!file_dave_nmass_storage_max        "dave_nmass_storage_max.out"        ! N storage capacity per individual (kgN/m2)
!file_dave_cmass_storage_dynam      "dave_cmass_storage_dynam.out"      ! C mass storage dynamics (> 0 when saving C) (kgC/m2)
!file_dave_storage_dynam_14sum      "dave_storage_dynam_14sum.out"      ! Mean 14-day cumulative C mass storage dynamics (> 0 if saving C) (kgC/m2)
!file_dave_height                   "dave_height.out"                   ! Plant height (m)
!file_dave_diameter                 "dave_diameter.out"                 ! Stem diameter (m)
!file_dave_basalarea                "dave_basalarea.out"                ! Mean Basal Area (m2/tree)
!file_dave_basalarea_inc            "dave_basalarea_inc.out"            ! Mean Basal Area increment (cm2/tree/day)
!file_dave_density                  "dave_density.out"                  ! Density of individuals over patch (/m2)
!file_dave_sapwood_area             "dave_sapwood_area.out"             ! Sapwood area sum of individuals (m2/m2)
!file_dave_latosa                   "dave_latosa.out"                   ! Leaf area to sapwood area ratio (unitless)
!file_dave_fpar                     "dave_fpar.out"                     ! Daily fpar [0-1]
!file_dave_phen                     "dave_phen.out"                     ! Daily phenology multiplier
!file_dave_lai_today                "dave_lai_today.out"                ! Daily LAI
!file_dave_indiv_npp                "dave_indiv_npp.out"                ! Daily cohort-level NPP (gC/m2/day)
!file_dave_indiv_gpp                "dave_indiv_gpp.out"                ! Daily cohort-level GPP (gC/m2/day)
!file_dave_resp_autotrophic         "dave_resp_auto.out"                ! Daily autotrophic respiration (gC/m2/day)  (Note: this does NOT include leaf respiration, as this is already accounted for in gpp!)
!file_dave_resp_maintenance         "dave_resp_maintenance.out"         ! Daily maintenance respiration (gC/m2/day)
!file_dave_resp_growth              "dave_resp_growth.out"              ! Daily growth respiration (gC/m2/day)
!file_dave_fnuptake                 "dave_fnuptake.out"                 ! Fraction of nitrogen demand taken up
!file_dave_nstorage_drawdown        "dave_nstorage_drawdown.out"        ! Amount of N withdrawn from storage today for growth (kgN/m2)
!file_dave_g1                       "dave_g1.out"                       ! Stomatal slope parameter (Medlyn et al. 2011) (kPa^0.5)
!file_dave_resp_repr                "dave_resp_repr.out"                ! Daily reproductive respiration (gC/m2/day)
!file_dave_resp_crown               "dave_resp_crown.out"               ! Daily crown respiration (gC/m2/day)
!file_dave_resp_leaf                "dave_resp_leaf.out"                ! Total Leaf respiration by PFT (gC/m2)
!file_dave_resp_root                "dave_resp_root.out"                ! Daily root respiration (gC/m2/day)
!file_dave_resp_sap                 "dave_resp_sap.out"                 ! Daily sapwood respiration (gC/m2/day)
!file_dave_fpc                      "dave_fpc.out"                      ! Daily FPC ()
!file_dave_crownarea                "dave_crownarea.out"                ! Daily Crown Area (m2)
!file_dave_agd_g                    "dave_agd_g.out"                    ! Daily gross photosynthesis (gC/m2/day)
!file_dave_rd_g                     "dave_rd_g.out"                     ! Daily leaf respiration (gC/m2/day)
!file_dave_je                       "dave_je.out"                       ! Daily PAR-limited photosynthesis rate (gC/m2/h)
!file_dave_vcmax                    "dave_vcmax.out"                    ! RuBisCO capacity (gC/m2/day)
!file_dave_vcmax25                  "dave_vcmax25.out"                  ! Max carboxylation rate at 25 degrees (vcmax 25) (umol/m2/s)
!file_dave_jmax25                   "dave_jmax25.out"                   ! Maximum e- transport rate at 25 degrees (jmax) (umol/m2/s)
!file_dave_fphen_activity           "dave_fphen_activity.out"           ! Phenological activity (0-1)
!file_dave_fdev_growth              "dave_fdev_growth.out"              ! Development factor for growth demand (0-1)
!file_dave_frepr_cstorage           "dave_frepr_cstorage.out"           ! Ratio reproductive biomass to storage capacity
!file_dave_growth_demand            "dave_growth_demand.out"            ! Growth Demand (0-1)
!file_dave_cmass_germ               "dave_cmass_germ.out"               ! Germinated C Mass (kgC/m2)
!file_dave_nscal                    "dave_nscal.out"                    ! Nitrogen stress scalar (0-1)
!file_dave_weighted_psi             "dave_weighted_psi.out"             ! Soil water potential weighted by root fraction or resistance in each layer (MPa)
!file_dave_soil_psi                 "dave_soil_psi.out"                 ! Soil water potential averaged over layers (MPa)
!file_dave_transpiration            "dave_transpiration.out"            ! Daily indiv-level transpiration (mm/day)
!file_dave_cue                      "dave_cue.out"                      ! Daily carbon use efficiency
!file_dave_ndemand                  "dave_ndemand.out"                  ! daily N demand mass (kgN/m2)
!file_dave_pet                      "dave_pet.out"                      ! Daily potential patch-level evapotranspiration (mm)
!file_dave_kmax_drought_affected    "dave_kmax_drought_affected.out"    ! Dynamic kmax value impacted by drought, gradually recovers (mol/m2/s/MPa)
!file_dave_max_k_loss               "dave_max_k_loss.out"               ! Fractional reduction in kmax due to xylem embolism
!file_dave_live_biomass             "dave_live_biomass.out"             ! Daily total live biomass (kg/m2)
!file_dave_wscal                    "dave_wscal.out"                    ! Water scalar [0-1], 1 = min stress
!file_dave_cmass_standing_repr      "dave_cmass_standing_repr.out"      ! Standing Dead Reproductive (Seedbank for grasses) C mass (kgC/m2)
!file_dave_nmass_standing_repr      "dave_nmass_standing_repr.out"      ! Standing Dead Reproductive (Seedbank for grasses) N mass (kgN/m2)
!file_dave_cmass_standing_leaf      "dave_cmass_standing_leaf.out"      ! Standing Dead Leaf C Mass (kgC/m2)
!file_dave_nmass_standing_leaf      "dave_nmass_standing_leaf.out"      ! Standing Dead Leaf N Mass (kgN/m2)
!file_dave_cmass_standing_root      "dave_cmass_standing_root.out"      ! Standing Dead Root C Mass (kgC/m2)
!file_dave_nmass_standing_root      "dave_nmass_standing_root.out"      ! Standing Dead Root N Mass (kgN/m2)
!file_dave_cmass_standing_sap       "dave_cmass_standing_sap.out"       ! Standing Dead Sap C Mass (kgC/m2)
!file_dave_nmass_standing_sap       "dave_nmass_standing_sap.out"       ! Standing Dead Sap N Mass (kgN/m2)
!file_dave_cmass_standing_heart     "dave_cmass_standing_heart.out"     ! Standing Dead Heartwood C Mass (kgC/m2)
!file_dave_nmass_standing_heart     "dave_nmass_standing_heart.out"     ! Standing Dead Heartwood N Mass (kgN/m2)
!file_dave_dresp                    "dave_dresp.out"                    ! Total daily pft-level autotrophic Respiration (kgC/m2)
!file_dave_cturnover_leaf           "dave_cturnover_leaf.out"           ! Daily leaf C turnover flux (kgC/m2/day)
!file_dave_cturnover_root           "dave_cturnover_root.out"           ! Daily root C turnover flux (kgC/m2/day)
!file_dave_cturnover_sap            "dave_cturnover_sap.out"            ! Daily sapwood C turnover flux (kgC/m2/day)
!file_dave_cturnover_repr           "dave_cturnover_repr.out"           ! Daily reproductive C turnover flux (kgC/m2/day)
!file_dave_cturnover_crown          "dave_cturnover_crown.out"          ! Daily crown C turnover flux (kgC/m2/day)
!file_dave_nturnover_leaf           "dave_nturnover_leaf.out"           ! Daily leaf N turnover flux (kgN/m2/day)
!file_dave_nturnover_root           "dave_nturnover_root.out"           ! Daily root N turnover flux (kgN/m2/day)
!file_dave_nturnover_sap            "dave_nturnover_sap.out"            ! Daily sapwood N turnover flux (kgN/m2/day)
!file_dave_nturnover_repr           "dave_nturnover_repr.out"           ! Daily reproductive N turnover flux (kgN/m2/day)
!file_dave_nturnover_crown          "dave_nturnover_crown.out"          ! Daily crown N turnover flux (kgN/m2/day)
!file_dave_turnover_leaf            "dave_turnover_leaf.out"            ! Daily leaf turnover as a proportion of leaf C biomass (unitless)
!file_dave_dphen                    "dave_dphen.out"                    ! Daily phen (-)
!file_dave_ftemp                    "dave_ftemp.out"                    ! Coefficient that scales growth demand using air temperature (0-1)
!file_dave_fwater                   "dave_fwater.out"                   ! Coefficient that scales growth demand using wscal (0-1)
!file_dave_fstorage                 "dave_fstorage.out"                 ! Coefficient that scales growth according to actualt storage state (0-1)
!file_dave_fphoto                   "dave_fphoto.out"                   ! Coefficient that scales growth according to relative day length (0-1)
!file_dave_cgrow_pot                "dave_cgrow_pot.out"                ! Coefficient used to scale cgrow by taking into account ftem, fwater and fstrage (0-1)
!file_dave_standing_dead            "dave_standing_dead.out"            ! Daily per-PFT total standing dead C mass (kgC/m2)

! Daily indiv-level per-patch array outputs.
!file_dave_layerwise_fpar           "dave_layerwise_fpar.out"           ! Daily layered fpar [0-1]
!file_dave_layerwise_lai            "dave_layerwise_lai.out"            ! Daily layered LAI (m2/m2)
!file_dave_layerwise_an             "dave_layerwise_an.out"             ! Daily layered net photosynthesis (mol/m2/s)
!file_dave_Rs_r                     "dave_Rs_r.out"                     ! Daily root-soil resistance by layer (mol/m/s/MPa)
!file_dave_water_uptake             "dave_water_uptake.out"             ! Water uptake from each soil layer (mm/day)

! Daily cohort-level outputs
!file_dave_indiv_cpool              "dave_indiv_cpool.out"              ! Indiv-level carbon pools (kgC/m2)
!file_dave_indiv_npool              "dave_indiv_npool.out"              ! Indiv-level nitrogen pools (kgN/m2)
!file_dave_hydraulics               "dave_hydraulics.out"               ! Summary file with kmax, lai and daily minimum lwp for all indivs
!file_dave_indiv_lai                "dave_indiv_lai.out"                ! Cohort-level LAI (m2/m2)
!file_dave_indiv_c_d_dbh            "dave_indiv_c_d_dbh.out"            ! annual diamter increment (m)
!file_dave_indiv_respiration        "dave_indiv_respiration.out"        ! Indiv-level respiration components (kgC/m2)
!file_dave_indiv_dbh                "dave_indiv_dbh.out"                ! Cohort-level DBH (m)
!file_dave_indiv_cpool              "dave_indiv_cpool.out"              ! Indiv-level carbon pools (kgC/m2)
!file_dave_indiv_tree_cpool         "dave_indiv_tree_cpool.out"         ! Indiv-level tree carbon pools (kgC/m2)
