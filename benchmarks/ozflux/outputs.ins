!file_dave_met_pressure          "dave_met_pressure.out"         ! Daily air pressure (Pa)
!file_dave_sompool_cmass         "dave_sompool_cmass.out"        ! Daily SOM pool C mass (kgC/m2)
!file_dave_sompool_nmass         "dave_sompool_nmass.out"        ! Daily SOM pool N mass (kgN/m2)

