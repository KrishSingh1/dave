!///////////////////////////////////////////////////////////////////////////////////////
! Output files
!///////////////////////////////////////////////////////////////////////////////////////

! outputdirectory is mandatory. Should be "./" for parallel runs.
outputdirectory "./out/"
ifdailyoutput 1

!file_dave_lai "dave_lai.out" 					! LAI by individual (m2/m2)
!file_dave_sla "dave_sla.out" 					! SLA by individual (m2/kgC)
!file_dave_cmass_leaf "dave_cmass_leaf.out" 	! Leaf C mass (kgC/m2)
!file_dave_nmass_leaf "dave_nmass_leaf.out" 	! N mass available (kgN/m2)
!file_dave_height "dave_height.out" 			! Plant height (m)
!file_dave_diameter "dave_diameter.out" 		! Stem diameter (m)
!file_dave_density "dave_density.out" 			! Density of individuals over patch (/m2)
!file_dave_fpar "dave_fpar.out" 				! Daily fpar [0-1]
!file_dave_assim "dave_assim.out" 				! Daily net C assimilation (gross photosynthesis minus leaf respiration (kgC/m2/day)
!file_dave_resp "dave_resp.out" 				! Daily growth respiration (kgC/m2/day)
!file_dave_npp "dave_npp.out" 					! Daily NPP (kgC/m2/day)
!file_dave_sw "dave_sw.out"						! Daily layered soil water content as fraction of available water holding capacity.

! DAVE outputs
file_fpar              "fpar.out"             ! Daily fpar [0-1]
file_dave_lai          "dlai.out"             ! Daily LAI (m2/m2)
!file_dave_cmass_leaf   "cmass_leaf.out"      ! Daily leaf cmass (kgC/m2)
!file_dave_sla          "sla.out"             ! Daily SLA (m2/kgC)
file_dave_nmass         "nmass_avail.out"     ! Daily N mass available (kgN/m2)
file_dave_wscal         "wscal.out"           ! Daily water stress [0-1], 1 = min stress
!file_fpar_layerwise    "fpar_layerwise.out"  ! Daily layered fpar [0-1]
!file_lai_layerwise     "lai_layerwise.out"   ! Daily layered LAI (m2/m2)
file_agd_g             "agd_g.out"           ! Daily gross photosynthesis (gC/m2/day)
!file_rd_g              "rd_g.out"            ! Daily leaf respiration (gC/m2/day)
!file_je                "je.out"              ! Daily PAR-limited photosynthesis rate (gC/m2/h)
!file_vm                "vm.out"              ! RuBisCO capacity (gC/m2/day)
!file_assim             "assim.out"           ! Daily net C assimilation (gross photosynthesis minus leaf respiration (kgC/m2/day)
!file_resp              "resp.out"            ! Daily growth respiration (kgC/m2/day)
file_dnpp              "dnpp.out"            ! Daily NPP (kgC/m2/day)
!file_subdaily_an       "subdaily_an.out"     ! Subdaily net photosynthesis (mol/m2/s)
!file_subdaily_rd       "subdaily_rd.out"     ! Subdaily leaf respiration (mol/m2/s)
!file_subdaily_anc      "subdaily_anc.out"    ! Subdaily RuBisCO-limited net photosynthesis (mol/m2/s)
!file_subdaily_anj      "subdaily_anj.out"    ! Subdaily RuBP regeneration-limited photoysnthesis (mol/m2/s)
!file_subdaily_gsw      "subdaily_gsw.out"    ! Subdaily stomatal conductance to water vapour (mol/m2/s)
!file_subdaily_ci       "subdaily_ci.out"     ! Subdaily intercellular CO2 concentration (mol/mol)
!file_subdaily_vcmax    "subdaily_vcmax.out"  ! Subdaily max carboxylation rate (mol/m2/s)
!file_subdaily_jmax     "subdaily_jmax.out"   ! Subdaily max electron transport rate (mol/m2/s)
!file_temps             "temps.out"           ! Subdaily temperature (°C)
!file_pars              "pars.out"            ! Subdaily PAR (J/m2/timestep)
!file_vpds              "vpds.out"            ! Subdaily VPD (kPa)

! Prefined yearly output
! These files may be outcommented if their output is not required.
file_cmass "cmass.out"
file_anpp "anpp.out"
file_agpp "agpp.out"
file_fpc "fpc.out"
file_aaet "aaet.out"
!file_lai "lai.out"
!file_cflux "cflux.out"
!file_doc "doc.out"
file_dens "dens.out"
!file_runoff "tot_runoff.out"
file_cpool "cpool.out"
!file_clitter "clitter.out"
!file_aburned_area_out "annual_burned_area.out"
!file_simfireanalysis_out "simfireanalysis.out"
!file_firert "firert.out"
!file_aiso "aiso.out"
!file_amon "amon.out"
!file_amon_mt1 "amon_mt1.out"
!file_amon_mt2 "amon_mt2.out"
!file_speciesheights "height.out"
!file_indiv "indiv.out"

!file_nmass "nmass.out"
!file_cton_leaf "cton_leaf.out"
!file_ngases "ngases.out"
!file_nsources "nsources.out"
!file_npool "npool.out"
!file_nlitter "nlitter.out"
!file_nuptake "nuptake.out"
!file_nflux "nflux.out"
!file_vmaxnlim "vmaxnlim.out"

! Monthly outputs
!file_mnpp "mnpp.out"
file_mlai "mlai.out"
!file_mrh "mrh.out"
!file_mgpp "mgpp.out"
!file_mra "mra.out"
!file_mnee "mnee.out"
!file_maet "maet.out"
!file_mpet "mpet.out"
!file_mevap "mevap.out"
!file_mintercep "mintercep.out"
!file_mrunoff "mrunoff.out"
!file_mwcont_upper "mwcont_upper.out"
!file_mwcont_lower "mwcont_lower.out"
!file_miso "miso.out"
!file_mmon "mmon.out"
!file_mmon_mt1 "mmon_mt1.out"
!file_mmon_mt2 "mmon_mt2.out"

!file_msoiltempdepth25 "soiltemp25cm.out"
!file_mch4 "mch4.out"
!file_mch4diff "mch4_diffusion.out"
!file_mch4plan "mch4_plant.out"
!file_mch4ebull "mch4_ebullition.out"

!file_msnow "msnowdepth.out"
!file_mwtp "mwtp.out"
!file_mald "mald.out"
!file_wetland_water_added "wetland_water_added.out"

!file_mburned_area_out "monthly_burned_area.out"
