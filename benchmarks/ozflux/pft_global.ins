pft "TrIBE" (

	! Tropical broadleaved evergreen tree

	include 1
	tree
	broadleaved
	shade_intolerant
	evergreen
	tropical
	turnover_leaf 0.5
	longevity 200
	fireresist 0.1
	eps_iso 24.0
	seas_iso 0
	eps_mon 0.32 0.09 0.07 0.06 0.06 0.04 0.04 0.07 0.05
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5

	! As calculated by ifcalcsla and ifcalccton.
