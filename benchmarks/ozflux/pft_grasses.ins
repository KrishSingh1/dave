!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings
!///////////////////////////////////////////////////////////////////////////////////////
! This ins file is specifically for grasses and grass-only runs.

group "common" (

	! Parameters common to all PFTs
	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 0

	lambda_max 0.8
	emax 10
	reprfrac 0.1
	wscal_min 0.35
	drought_tolerance 0.0001	! default value - ensures that this has little effect even if
					! ifdroughtlimitedestab is turned on
	landcover "natural"
	harv_eff 0
	res_outtake 0

	! Peatland parameters - for mosses
	turnover_harv_prod 1 ! Turnover rate for long-lived harvested products (wood) : 1-year turnover time
	harvest_slow_frac 0

	! Default peatland values unless overriden in PFT definitions
	wtp_max -301 			! [mm] maximum inundation (water table) tolerance,
					! i.e. restrict on wetlands because wtp >= -300 always
	inund_duration 0		! [day] maximum days per month of inundation before GPP is reduced to 0
	min_snow 0.0 			! [mm] minimum snow needed for establishment (DJF average) and survival
					! (20-year average maximum), i.e. No restriction here
	max_snow 100000			! [mm] maximum snow tolerance (never used), i.e. No restriction here
	gdd0_max 100000			! [degC day] max GDD0, i.e. No restriction here
	gdd0_min 0			! [degC day] min GDD0, i.e. No restriction here
	has_aerenchyma 0		! PFTs do not have aerenchyma for gas transport by default
	stem_frac 1
	twig_frac 0
	max_mobil_cstorage 0.2

	! davephotosyn parameters
	gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))
	g0 0.005
	g1 3.4

	vcmax_25 91.0  			! vcmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0
	jmax_25 154.7  			! jmax at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0
	vpmax_25 100.0 			! vpmax  at 25degC in μmol/m2/s. Only used if ifcalcvcmax = 0
	ha_v 59.70	   			! Activation energy for vcmax (kJ mol-1)
	ha_j 40.71	   			! Activation energy for jmax (kJ mol-1)
	ds_v 639.43	   			! Entropy terms (deltaS) for vcmax (J mol-1 K-1)
	ds_j 642.97	   			! Entropy terms (deltaS) for jmax (J mol-1 K-1)
	extkn 0.15

	! hydraulics module parameters
	kmax 100 				! maximum hydraulic conductance (mol/m2/s/MPa) per unit xylem area - to be tuned
	stom_clos -1.5   		! water potential at which stomata close and roots disconnect from soil (MPa)
	p50 -3   				! water potential at 50% loss of xylem conductance (MPa)
	p88 -4   				! water potential at 88% loss of xylem conductance (MPa)
	nx 0.5  				! water holding capacity of the xylem conduits plus nonconducting tissues (unitless)
	g1x 2  					! g1 at leaf water potential = -0.3 Mpa (Zhou et al. 2014)
	b1z 2  					! Parameter for Zhou et al. (2014) stomatal model 
	
)

group "tree" (

	! Parameters common to all trees

	common
	ifcalcvcmax 0
	lifeform "tree"
	crownarea_max 50
	ltor_max 1
	turnover_root 0.7
	rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
	root_beta 0.982
	k_allom2 60
	k_allom3 0.67
	k_rp 1.6
	wooddens 200
	cton_root 29
	cton_sap 330
	nuptoroot 0.0028
	km_volume 0.000001477
	pathway "c3"
	respcoeff 1.0
	kest_repr 200
	kest_bg 0.1
	kest_pres 1
	k_chilla 0
	k_chillb 100
	k_chillk 0.05
	litterme 0.3
	boleht_frac 0.7


	harv_eff 0.9		! Value for forestry
	res_outtake 0.4		! Value for forestry
	turnover_harv_prod 0.04 ! Turnover rate for long-lived harvested products (wood): 
				! 0.04 corresponds to a 25-year turnover time (as in Bondeau 2007)
	harvest_slow_frac 0.33	! Bondeau 0.33
	stem_frac 0.65
	twig_frac 0.13
	turnover_repr_litter 0.25
	turnover_repr 0.5

	! 95% percentile NSC concentrations from eucface.

	! Maximum NSC concentration in dead bark.
	max_bark_nsc_conc  0.203

	! Maximum NSC concentration in leaves.
	max_leaf_nsc_conc  0.243

	! Maximum NSC concentration in twigs.
	max_twig_nsc_conc  0.0688

	! Maximum NSC concentration in wood.
	max_wood_nsc_conc  0.0797

	! Fraction of dead woody biomass that is bark. Plucked out of thin air.
	bark_frac  0.01
)

group "shrub" (

	common
	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 0
	lifeform "tree"
	leafphysiognomy "broadleaf"
	crownarea_max 10
	ltor_max 1
	k_allom1 100
	k_allom2 5
	k_allom3 0.67
	k_rp 1.6
	wooddens 250
	cton_root 29
	cton_sap 330
	nuptoroot 0.0028
	km_volume 0.000001477
	fnstorage 0.3
	pathway "c3"
	kest_repr 200
	kest_bg 0.1
	kest_pres 1
	litterme 0.3
	rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
	root_beta 0.982
	longevity 100
	boleht_frac 0

	harv_eff 0.9		! Value for forestry
	res_outtake 0.4		! Value for forestry
	turnover_harv_prod 1 	! Turnover rate for long-lived harvested products (wood): 
				! 1-year turnover time
	harvest_slow_frac 0
)

group "grass" (
 
	! Parameters common to all grasses
 
	common
	! Whether vcmax is calculated from leaf nutrient content (alt: prescribed).
	ifcalcvcmax 1
	leafphysiognomy "broadleaf"
	ltor_max 2.0
	rootdist 0.18 0.18 0.18 0.18 0.18 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01
	!root_beta 0.9555
	root_beta 0.97
	gmin 0.5
	phenology "any"
	phengdd5ramp 100
	phengdd5mat 2000.0
	turnover_leaf 1.0
	turnover_root 0.7
	turnover_repr_litter 0.2
	!cton_leaf_min 16
	cton_root 29
	nuptoroot 0.00551
	km_volume 0.000001876
	fnstorage 0.3
	litterme 0.2
	parff_min 1000000
	fireresist 0.5
	intc 0.01
	ga 0.030
	wscal_min 0.4
 
	turnover_harv_prod 1 	! Turnover rate for long-lived harvested products (wood):
				! 1-year turnover time for GRASS
	harvest_slow_frac 0

	! Juergen's grasses parameters
	tlp -1.0 				! Turgor loss point (needed for grasses)
	crownfrac 0.0
	culmfrac 0.0
	turnover_repr_litter 0.2

	
	crelocfrac 0        ! Fraction of senesced carbon retranslocated back to storage.
	senesc_base 0.00015  ! Baseline senescence rate (d-1).

	! Senescence coefficient for dormancy in dave grasses. Senescence rate is
	! increased by this factor when phenology is changing at the maximum rate.
	senesc_scal_dorm 300

	! Senescence coefficient for water stress in dave grasses. Senescence rate
	! is increased by this factor under max water stress.
	senesc_scal_water 100

	! Increase in senescence rate per 1℃, for temperatures below 0 ℃
	! (Johnson & Thornley 1983).
	temp_senesc1 1.0

	! Increase in senescence rate per 1℃, for temperatures above 0 ℃
	! (Johnson & Thornley 1983).
	temp_senesc2 0.05
)


!///////////////////////////////////////////////////////////////////////////////
! Grass PFT parameters
!///////////////////////////////////////////////////////////////////////////////
 
group "C3G" (

	! Cool (C3) grass

	include 1
	grass
	pathway "c3"
	g0 0.161
	g1 4.5
	gcutic 0.0012
	respcoeff 1.0
	Ha_growth 63.3
	T0_growth 30.6
	A_growth 4.64411906e8
	tcmin_surv -1000	! no limit
	tcmin_est -1000 	! no limit
	tcmax_est 1000  	! no limit
	twmin_est -1000 	! no limit
	gdd5min_est 0   	! no limit
	temp_dormancy 4.0
	eps_iso 16.0
	seas_iso 1
	eps_mon 0.37 0.2 0.23 0.1 0.1 0.09 0.1 0.22 0.19
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5
	harv_eff 0.5
	pstemp_min -5
	pstemp_low 10
	pstemp_high 30
	pstemp_max 45
)

group "perennial" (

	! Perennial grass.

	lifeform "grass_perennial"

	! Senescence coefficient for water stress in dave grasses. Senescence rate
	! is increased by this factor under max water stress.
	senesc_scal_water 50

	! Senescence coefficient for reproductive phase in dave grasses.
	! Senescence rate is increased by this factor during reproductive phase.
	senesc_scal_repr 30

	! Exponent shaping development-driven senescence for dave grasses. Higher
	! values delay senescence (less early, more late in the reproductive
	! phase). Unitless.
	qdev_senesc 2

	! Exponent shaping water stress-driven senescence for DAVE grasses. q = 1
	! gives a linear response. q > 1 increases senescence at moderate stress;
	! 0 < q < 1 reduces it. No effect at the extremes (wscal = 0 or 1).
	! Unitless.
	qwater_senesc 0.8
)

group "annual" (

	! Annual grass.

	lifeform "grass_annual"

	! Senescence coefficient for reproductive phase in dave grasses.
	! Senescence rate is increased by this factor during reproductive phase.
	senesc_scal_repr 120

	! Exponent shaping development-driven senescence for dave grasses. Higher
	! values delay senescence (less early, more late in the reproductive
	! phase). Unitless.
	qdev_senesc 35

	! Exponent shaping water stress-driven senescence for DAVE grasses. q = 1
	! gives a linear response. q > 1 increases senescence at moderate stress;
	! 0 < q < 1 reduces it. No effect at the extremes (wscal = 0 or 1).
	! Unitless.
	qwater_senesc 1
)

pft "C3G_perennial" (

	C3G
	perennial

	include 1

	sla                35.0
    cton_leaf_min      13.7
	RGR_pot            0.2
	max_mobil_cstorage 0.3
	reprfrac           0.1
	crownfrac          0.1
	culmfrac           0.1
	extkn              0.17
)


pft "C3G_annual" (
	
	C3G
	annual

	include 0

	sla                53.1
	cton_leaf_min      13.7
	RGR_pot            0.3
	max_mobil_cstorage 0.7
	reprfrac           0.6
	crownfrac          0.02
	culmfrac           0.2
	extkn              0.23
)


group "C4G" (

	! Warm (C4) grass

	include 1

	grass
	pathway "c4"
	g0 0.049
	g1 1.62
	gcutic 0.0012
	respcoeff 1.0
	pstemp_min 6
	pstemp_low 20
	pstemp_high 45
	pstemp_max 55
	Ha_growth 60.6
	T0_growth 37.3
	A_growth 9.3006791e7
	tcmin_surv -1000    ! no limit
	tcmin_est -1000     ! no limit
	tcmax_est 1000		! no limit
	twmin_est -1000		! no limit
	gdd5min_est 0		! no limit
	temp_dormancy 15.0
	eps_iso 8.0
	seas_iso 0
	eps_mon 0.48 0.19 0.67 0.14 0.12 0.13 0.14 0.29 0.24
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5
	harv_eff 0.5
)

pft "C4G_perennial" (

	C4G
	perennial

	include 1

	sla    	           35.0
	cton_leaf_min      17.1
    max_mobil_cstorage 0.2
	reprfrac           0.2
	crownfrac          0.2
	culmfrac           0.6
	extkn              0.17
)


pft "C4G_annual" (

   C4G
   annual

   include 0

   sla  	          53.1
   cton_leaf_min      17.1
   max_mobil_cstorage 0.7
   reprfrac           0.6
   crownfrac          0.02
   culmfrac           0.2
   extkn              0.23
)
