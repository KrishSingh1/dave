!///////////////////////////////////////////////////////////////////////////////////////
! PARAMETERS FOR PFTS
! Run GUESS with -help option for list of keywords and their meanings
!///////////////////////////////////////////////////////////////////////////////

group "common" (

	! Parameters common to all PFTs
  
	lambda_max 0.8
	emax 5
	reprfrac 0.1
	wscal_min 0.35
	drought_tolerance 0.0001	! default value - ensures that this has little effect even if
					! ifdroughtlimitedestab is turned on
	landcover "natural"
	harv_eff 0
	res_outtake 0

	! Peatland parameters - for mosses
	turnover_harv_prod 1 ! Turnover rate for long-lived harvested products (wood) : 1-year turnover time
	harvest_slow_frac 0

	! Default peatland values unless overriden in PFT definitions
	wtp_max -301 			! [mm] maximum inundation (water table) tolerance,
					! i.e. restrict on wetlands because wtp >= -300 always
	inund_duration 0		! [day] maximum days per month of inundation before GPP is reduced to 0
	min_snow 0.0 			! [mm] minimum snow needed for establishment (DJF average) and survival
					! (20-year average maximum), i.e. No restriction here
	max_snow 100000			! [mm] maximum snow tolerance (never used), i.e. No restriction here
	gdd0_max 100000			! [degC day] max GDD0, i.e. No restriction here
	gdd0_min 0			! [degC day] min GDD0, i.e. No restriction here
	has_aerenchyma 0		! PFTs do not have aerenchyma for gas transport by default
)

group "tree" (

	! Parameters common to all trees

	common
	lifeform "tree"
	crownarea_max 50
	ltor_max 1
	turnover_root 0.7
	rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
	root_beta 0.982
	k_allom2 60
	k_allom3 0.67
	k_rp 1.6
	wooddens 200
	cton_root 29
	cton_sap 330
	nuptoroot 0.0028
	km_volume 0.000001477
	pathway "c3"
	respcoeff 1.0
	kest_repr 200
	kest_bg 0.1
	kest_pres 1
	k_chilla 0
	k_chillb 100
	k_chillk 0.05
	litterme 0.3

	harv_eff 0.95
	res_outtake 0.75
	turnover_harv_prod 0.04 ! Turnover rate for long-lived harvested products (wood):
				! 0.04 corresponds to a 25-year turnover time (as in Bondeau 2007)
	harvest_slow_frac 0.33	! Bondeau 0.33
)

group "shrub" (

	common
	lifeform "tree"
	leafphysiognomy "broadleaf"
	crownarea_max 10
	ltor_max 1
	k_allom1 100
	k_allom2 5
	k_allom3 0.67
	k_rp 1.6
	wooddens 250
	cton_root 29
	cton_sap 330
	nuptoroot 0.0028
	km_volume 0.000001477
	fnstorage 0.3
	pathway "c3"
	kest_repr 200
	kest_bg 0.1
	kest_pres 1
	litterme 0.3
	rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
	root_beta 0.982
	longevity 100

	turnover_harv_prod 1 	! Turnover rate for long-lived harvested products (wood):
				! 1-year turnover time
	harvest_slow_frac 0
)

group "grass" (

	! Parameters common to all grasses

	common
	lifeform "GRASS_PERENNIAL"
	leafphysiognomy "broadleaf"
	ltor_max 0.5
	rootdist 0.18 0.18 0.18 0.18 0.18 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01
	root_beta 0.9555
	gmin 0.5
	phenology "any"
	phengdd5ramp 100
	leaflong 0.5		! Leaf longevity (years)
	turnover_leaf 1
	turnover_root 0.7
	!cton_leaf_min 16
	cton_root 29
	nuptoroot 0.00551
	km_volume 0.000001876
	fnstorage 0.3
	litterme 0.2
	parff_min 1000000
	fireresist 0.5
	intc 0.01
	ga 0.030

	turnover_harv_prod 1 	! Turnover rate for long-lived harvested products (wood):
				! 1-year turnover time for GRASS
	harvest_slow_frac 0

  g0 0.005
	g1 3.4
	vcmax_25 91.0 ! vcmax at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	jmax_25 154.7 ! jmax at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	vpmax_25 100.0 ! vpmax  at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	ha_v 59.70
	ha_j 40.71
	ds_v 639.43
	ds_j 642.97
)

group "broadleaved" (

	! Parameters common to all broadleaved trees

	leafphysiognomy "broadleaf"
	!cton_leaf_min 16
	k_allom1 250
	k_latosa 6000
	gmin 0.5
	intc 0.02
	ga 0.040
)

group "evergreen" (

	! Parameters common to all evergreen trees

	phenology "evergreen"
	fnstorage 0.05
	phengdd5ramp 0
)

group "temperate" (

	! Parameters common to all temperate trees

	pstemp_min -2
	pstemp_low 15
	pstemp_high 25
	pstemp_max 38
	respcoeff 1.0
)

group "tropical" (

	! Parameters common to all tropical trees

	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000   	! no limit
	twmin_est -1000  	! no limit
	gdd5min_est 0    	! no limit
	pstemp_min 2
	pstemp_low 25
	pstemp_high 30
	pstemp_max 55
	respcoeff 0.15
)

! greff_min values below calibrated for the smooth (ifsmoothgreffmort 1) option
group "shade_tolerant" (
 
)

! So far only example values; not used in this global version
group "intermediate_shade_tolerant" (
  ! est_max .5
	turnover_sap 0.075
  
  ! ORIGINALS
	est_max 0.15
	parff_min 2000000
	alphar 7.0
	greff_min 0.06
	! turnover_sap 0.1
)

group "shade_intolerant" (
  sapsize 0.2
  est_max 0.10
  parff_min 5000000
  alphar 50.0

	! ORIGINALS
  ! est_max 0.2
	! parff_min 2500000
	! alphar 11.0
	greff_min 0.09
	turnover_sap 0.1
)

group "global" (
  sapsize 0.1
  formfactor 1.0
  lambda_max 0.8
  emax 5.0
  reprfrac 0.1
  wscal_min 0.35
  drought_tolerance 0.0001
  stem_frac 1
  twig_frac 1
  g0 0.005

  ! NEW ONES
  g1 3.4
  gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))
  temp_dormancy 5.0
  extkn 0.15
	turnover_repr 0.25
  cton_leaf_min 29.01 ! from TeBE

  vcmax_25 91.0 ! vcmax at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	jmax_25 154.7 ! jmax at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	vpmax_25 100.0 ! vpmax  at 25degC in mol/m2/s. Only used if ifcalcvcmax = 0.
	ha_v 59.70
	ha_j 40.71
	ds_v 639.43
	ds_j 642.97
)

! Rainforest Shade Tolerant
pft "RST" (
  global
  include 1
  landcover "natural"
  lifeform "tree"
  shade_tolerant
  drought_tolerance 0.7
  crownarea_max 50.00000000
  ltor_max 1.00000000
  turnover_root 0.70000000
  rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
  root_beta 0.98200000
  k_allom1 150.00000000
  k_rp 1.62000000
  ! k_allom2 30.29 ! fitted to all data
  ! k_allom3 0.34 ! fitted to all data
  ! k_allom2 60.0000000 ! CRT (Lina)
  ! k_allom3 0.87000000 ! CRT (Lina)
  k_allom2 59.95079 ! fitted to binned data
  k_allom3 0.8177464 ! fitted to binned data
  ! k_latosa 2120
  k_latosa 4175.00000000
  ! wooddens 261.00000000 ! Austraits
  wooddens 290 ! Tim Wardlaw's estimates
  formfactor 0.46 ! extracted from allometic equation (Tim Wardlaw's)
  cton_root 29.00000000
  cton_sap 330.00000000
  nuptoroot 0.00280000
  km_volume 0.00000148
  pathway "c3"
  respcoeff 1.00000000
  kest_repr 200.00000000
  kest_bg 0.10000000
  kest_pres 1.00000000
  k_chilla 0.00000000
  k_chillb 100.00000000
  k_chillk 0.05000000
  !litterme 0.30000000
  litterme 0.40000000 ! less flammable
  harv_eff 0.95000000
  res_outtake 0.75000000
  turnover_harv_prod 0.04000000
  harvest_slow_frac 0.33000000
  leafphysiognomy "broadleaf"
  fnstorage 0.05000000
  longevity 300.00000000
  gmin 0.50000000
  phenology "evergreen"
  phengdd5ramp 0.00000000
  leaflong 2.70000000
  turnover_leaf 0.37000000
  turnover_root 0.70000000
  sla 16.831
  fireresist 0.00000000
  intc 0.02000000
  ga 0.04000000
  pstemp_min -40.00000000
  pstemp_low -40.00000000
  pstemp_high 40.00000000
  pstemp_max 40.00000000
  tcmin_surv -40.00000000
  tcmin_est -40.00000000
  tcmax_est 40.00000000
  twmin_est -40.00000000
  gdd5min_est 500
  ! gdd5min_est 2000.00000000
  eps_iso 24.00000000
  seas_iso 0.00000000

  vcmax_25 41.5 ! N. cunninghamii (Camille)
	jmax_25 91.344 ! N. cunninghamii (Camille)
	ha_v 72.518902359 ! N. cunninghamii (Camille)
	ds_v 655.3872 ! N. cunninghamii (Camille)
	ha_j 44.3213 ! N. cunninghamii (Camille)
	ds_j 657.97027 ! N. cunninghamii (Camille)
)

! Tall Resprouter Eucalypt (E. obliqua; E. globulus)
pft "TRspE" (
  global
  include 1
  landcover "natural"
  lifeform "tree"
  shade_intolerant
  crownarea_max 100.00000000
  ! ltor_max 1.00000000
  ltor_max 2.0000000
  ! turnover_root 0.70000000
  turnover_root 0.5 ! imported from the assaf's daily allocation (TeBE)
  rootdist 0.12 0.12 0.12 0.12 0.12 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04 0.04
  root_beta 0.98200000
  k_allom1 146.00000000
  k_rp 1.62000000
  k_allom2 47.48
  k_allom3 0.64
  k_latosa 4175.00000000
  wooddens 281.25
  formfactor 0.6339 ! for E. Obliqua using individual-tree data from the site (excluding one outlayer)
  ! formfactor 0.36 ! extracted from allometic equation (Tim Wardlaw's)
  cton_root 29.00000000
  cton_sap 330.00000000
  nuptoroot 0.00280000
  km_volume 0.00000148
  pathway "c3"
  respcoeff 1.00000000
  kest_repr 200.00000000
  kest_bg 0.10000000
  kest_pres 1.00000000
  k_chilla 0.00000000
  k_chillb 100.00000000
  k_chillk 0.05000000
  litterme 0.30000000
  harv_eff 0.95000000
  res_outtake 0.75000000
  turnover_harv_prod 0.04000000
  harvest_slow_frac 0.33000000
  leafphysiognomy "broadleaf"
  fnstorage 0.05000000
  longevity 500.00000000
  gmin 0.50000000
  phenology "evergreen"
  phengdd5ramp 0.00000000
  leaflong 2.00000000
  turnover_leaf 0.5000000
  turnover_root 0.70000000
  sla 8.8
  fireresist 0.80000000
  intc 0.02000000
  ga 0.04000000
  pstemp_min -40.00000000
  pstemp_low -40.00000000
  pstemp_high 40.00000000
  pstemp_max 40.00000000
  tcmin_surv -40.00
  tcmin_est -40.00
  tcmax_est 40
  twmin_est -40
  gdd5min_est 500
  ! gdd5min_est 2000.00000000
  eps_iso 24.00000000
  seas_iso 0.00000000

  vcmax_25 58.5 ! E. Obliqua (Camille)
	jmax_25 111.249 ! E. Obliqua (Camille)
	ha_v 72.767 ! E. Obliqua (Camille)
	ds_v 639.707 ! E. Obliqua (Camille)
	ha_j 32.663 ! E. Obliqua (Camille)
	ds_j 634.559695 ! E. Obliqua (Camille)
)


