!///////////////////////////////////////////////////////////////////////////////////////
!
! OzFlux global settings.
!
! LPJ-GUESS OZFLUX INSTRUCTION SCRIPT FOR COHORT/INDIVIDUAL MODE
! Global PFTs
!
! LPJ-GUESS 4.1 (daily_grass)
!
!///////////////////////////////////////////////////////////////////////////////////////

!///////////////////////////////////////////////////////////////////////////////////////
! Options common to all ozflux sites
!///////////////////////////////////////////////////////////////////////////////////////

! Main switches
ifdailygrass             1   ! Daily allocation for grasses and crops
ifdailytree              1   ! Daily allocation for trees and shrubs
ifdavephotosyn 		     1   ! DAVE photosynthesis scheme (in need of a better name...)
ifdavegrowth             1   ! DAVE growth scheme
ifdavehydrology          1   ! DAVE hydrology updates
ifdavehydraulics         1   ! DAVE hydraulics scheme (requires davephotosyn and davehydrology)
ifzhou                   1   ! Zhou response of photosynthesis to water stress (via water potential). Requires ifdavehydrology
ifdavediagnostics        0   ! DAVE mass balance diagnostics
ifapproximate_C4         1   ! Use approximation of von Caemmerer 2000 C4 photosynthesis model?
use_mean_annual_co2      1   ! If true, each day's CO2 value will be the mean annual co2 for the current year. Otherwise, a mean of that day's subdaily data will be used.
ifusegdd                 0   ! If true, use growing degree days to calculate growth stage, otherwise infer from biomass dynamics
ifevenlaidist            1   ! Whether LAI is distributed evenly across canopy layers for grasses.
ifadaptive_rootdist      0   ! Adaptive root distribution and response window?
epsiresolution           100 ! Resolution for splines used to calculate psi from transpiration. This is the number of control points used for the integration. Default: 100.
iftreephen               0   ! Turn on/off tree phenology (Dave)
ifgrote                  1   ! Turn on/off grote tree allocation (Requires ifdailytree 1)
ifvcmaxtempacclimation   0   ! Acclimation of vcmax to temperature.
ifresptempacclimation    0   ! Acclimation of maintenance respiration to temperature.
soildepth_evap           500 ! Depth of sublayer at top of upper soil layer, from which evaporation is possible Must be a multiple of 100. Trunk default is 200, Clare had 500
ifstoreuptake            1   ! Whether tree N uptake goes into long-term storage pool.
ifdailycstarvmort        1   ! Turn on/off daily carbon starvation mortality in trees (Dave)

! Soil Data
 file_soildata         		  "../forcing/soilmap_center_interpolated.dat"        ! Relative to the main .ins file, not this one
! file_soildata         		  "../forcing/slga.ozflux.dat"        ! from soil & landscape grid

! Simfire Data
param "file_simfire"          (str "../forcing/SimfireInput.bin")                        ! Relative to the main .ins file, not this one

! N Deposition Data
! This is optional if variable_ndep_nhx and variable_ndep_noy are set, in which
! case N deposition data will be read from the NetCDF file.
param "file_ndep"             (str "../forcing/ndep/GlobalNitrogenDeposition.bin")    ! Relative to the main .ins file, not this one

! Disturbance Data (optional)
param "file_disturbance"      (str "")

! Stand Disturbance Data (optional)
param "file_disturbance_st"   (str "")

! Elevation Data (optional)
param "file_elevation_st"     (str "")

! File containing long-term mean maximum temperature of warmest month, used for
! DAVE temperature acclimation of photosynthesis. Only required if
! ifvcmaxtempacclimation is enabled. If not provided, thome will be calculated
! from the climate data.
file_thome                      ""

! Number of timesteps per day.
nsteps_day            			8

! Search radius in soil input file
searchradius_soil               50

! Other site-agnostic settings.

! 1 to enable sensibility checking of inputs, 0 otherwise
nc_check_inputs                0

! Cache strategy used when reading netcdf data.
! 0 = cache entire file (fastest, most memory intensive)
! 1 = cache one year at a time (slower, but uses less memory)
! 2 = no caching (slowest, not recommended)
cache_strategy                0

! Scenario to be used for nitrogen deposition data.
! HISTORIC, RCP26, RCP45, RCP60, RCP85
ndep_scenario                "rcp60"
useClosestNdep               1   ! Use closest available N Deposition data if none found for this gridcell

! User input from the instruction file. The number of years of data to recycle
! during the spinup. If 0, all data will be recycled during freenyears.
spinup_met_cycle_length      0

! Algorithm used to estimate saturation vapour pressure (esat) from air
! temperature. Required iff variable_rh is set. Valid options are:
! sonntag_1990, alduchov_1996, allen_1998
esat_method                  "sonntag_1990"

! Input file containing atmospheric co2 concentration by year. This is optional
! if co2 data is being read from the NetCDF file (ie if variable_co2 is set).
file_co2                      "../forcing/global_co2_ann_1700_2040.txt" ! note extended to 2040 for synthetic drought/recovery at CuP - just added diff from 2022-23 every year
!file_co2                     "../forcing/co2_1901_2018.txt"
!file_co2                     "../forcing/co2_historical_1951_2005.dat"
!file_co2                     "../forcing/co2_rcp45_1765_2500.dat"
!file_co2                     "../forcing/co2_rcp85_1765_2500.dat"

! Maximum number of cohorts allowed to coexist per pft (0 = unlimited)
nindiv_max               0

! Set to 1 to force all individuals to use constant/fixed LAI.
! The monthly LAI values are defined at the bottom of canexch.h.
ifforcedlai                  0

! The fixed LAI value (m2/m2) applied to all cohorts when ifforcedlai is 1.
! This is a required parameter with ifforcedlai 1.
!fixed_lai                    1.5

! Set to non-zero to use this as a constant value of air pressure (Pa).
fixed_pressure               0

! Optional constant to be added to daily temperature (°C).
temperature_delta            0

! Optional constant to be added to daily co2 (ppm).
co2_delta                    0

! Optional constant by which to multiply all precipitation values.
precip_scalar                1

! Interval in seconds between progress reports; 0 for yearly or -1 for daily.
progress_interval            0

! Force the use of newline characters to terminate progress messages. Useful for MPI runs.
progress_newline             0

! If enabled, invalid mathematical operations (such as division by 0) will result in a fatal error.
strict_math                  1

! Number of vertical layers used for canopy-area integration.
! Mutually exclusive with layer_thickness_canopy.
!nlayer_canopy               10

! Width of vertical layers for canopy-area integration (m) (default: 2).
! Mutually exclusive with nlayer_canopy.
!layer_thickness_canopy      2

! Iff enabled, patch-level outputs will be written during spinup.
spinup_output               0

! Iff enabled, outputs will be written in gzip (ie compressed) format.
gzip_output                  0

! Iff enabled, patch-level outputs will be written as mean/median/standard
! deviation instead.
patch_output_stats           0

! Verbosity level in log file (0-6, higher is more verbose).
verbosity                    3

! The first year after the spinup period. During spinup, all met data before
! this year is cycled. If not set, all available data will be cycled during the
! spinup.
!simulation_start_year       2020

!///////////////////////////////////////////////////////////////////////////////////////
! RUN PARAMETERS AND OPTIONS
!///////////////////////////////////////////////////////////////////////////////////////

! Settings recognised by Plib
! Run GUESS with -help option for list of keywords and their meanings

!title 'LPJ-GUESS cohort mode - global pfts'

vegmode "cohort"        ! "cohort", "individual" or "population"
nyear_spinup 500        ! Number of years to spin up the simulation for
ifcalcsla 0            ! Whether to calculate SLA from leaf longevity
                ! (PFT-specific value can be specified in this file instead)
ifcalccton 0            ! Whether to calculate leaf C:N min from leaf longevity
                ! (PFT-specific value can be specified in this file instead)
firemodel "NOFIRE"        ! BLAZE, GLOBFIRM, NOFIRE
weathergenerator "GWGEN"    ! GWGEN, INTERP
npatch       1          ! Number of replicate patches to simulate
patcharea    1000       ! Patch area (m2)

ifcdebt 1            ! Whether to allow vegetation C storage (1) or not (0)
wateruptake "root_resistance"      ! "wcont", "rootdist", "smart" or "speciesspecific", "root_resistance"
                         ! see documentation for water_uptake()
rootdistribution "jackson"    ! How to parameterise root distribution. Alternatives are "fixed" or "jackson".
textured_soil 1                 ! Whether to use silt/sand fractions specific to soiltype
ifsmoothgreffmort 1        ! Whether to vary mort_greff smoothly with growth efficiency (1)
                ! or to use the standard step-function (0)
                ! greff_min values below calibrated for the smooth (1) option
ifdroughtlimitedestab 0        ! Whether establishment is limited by growing season drought
                ! guess2008 - species version has 1
ifrainonwetdaysonly 1        ! Whether to rain on wet days only (1), or to rain a bit every day (0)
ifbvoc 0                         ! Whether to include BVOC calculations (1) or not (0)

!///////////////////////////////////////////////////////////////////////////////
! Disturbance
!///////////////////////////////////////////////////////////////////////////////
ifdisturb    1          ! Whether generic patch-destroying disturbances enabled
disttype     "DETERMINISTIC"     ! Disturbance regime ("NONE", "STOCHASTIC" (requires distinterval), "DETERMINISTIC" (requires file_disturb))

distinterval 30        ! Average return time for generic patch-destroying disturbances
                        ! Only used if disttype = "STOCHASTIC"
                        ! Hickler et al. (2011) used 200

file_disturb "../disturbances.txt"        ! Path to a plaintext file containing years in which
                        ! disturbances should occur, one value per line.
                        ! Only used if disttype = "DETERMINISTIC"
                        ! It may be more useful to include this in the site-
                        ! -specific instruction files.

!///////////////////////////////////////////////////////////////////////////////
! Establishment
!///////////////////////////////////////////////////////////////////////////////
estinterval  5          ! Years between establishment events in cohort mode
ifbgestab 1            ! Whether background establishment enabled
ifsme 1                ! Whether spatial mass effect enabled
ifstochestab 1            ! Whether establishment stochastic
ifstochmort 1            ! Whether mortality stochastic

!///////////////////////////////////////////////////////////////////////////////
! ARCTIC AND WETLAND SWITCHES
!///////////////////////////////////////////////////////////////////////////////

iftwolayersoil 0		! Use the original LPJ-GUESS v4 two layer soil and snow scheme, or not (0, by default). 
				! Of the switches below, iforganicsoilproperties, ifcarbonfreeze and 
				! ifmultilayersnow must all be 0 if iftwolayersoil = 1
				! Furthermore, run_peatland must be 0 when using the two layer soil, and 
				! rootdistribution must be "fixed"

ifmultilayersnow 1 		! 0 is the old, single-layer scheme. 1 by default (applies to all stand types)
iforganicsoilproperties 0	! Whether to update physical soil properties using soil carbon content 
				! (applies only to non peatland, mineral stands not classified as organic)
ifcarbonfreeze 1		! Whether to allow some decomposition below 0 degC in upland soils (1 by default), or not (0)

! WETLAND SWITCHES (no effect when run_peatland 0)
ifinundationstress 1		! Whether to reduce daily GPP if there's inundation on peatlands (1), or not (0)
wetland_runon 0			! Extra daily water input to (>0), or output from (<0), wetlands (mm/day). 
				! 0 by default, non-zero for site specific studies.
ifmethane 0			! Whether to run the methane model and calculate methane fluxes
ifsaturatewetlands 0		! Whether to take water from runoff to saturate low latitide wetlands (1), or not (0)


!///////////////////////////////////////////////////////////////////////////////
! PROCESS SETTINGS SPECIFIC TO NITROGEN
!///////////////////////////////////////////////////////////////////////////////

ifcentury 1            ! Whether to use CENTURY SOM dynamics (mandatory for N cycling)
ifnlim 1            ! Whether plant growth limited by available N
freenyears 100            ! Number of years to spin up without N limitation (needed to build up a N pool)
nfix_a 0.102            ! First term in N fixation eqn (Conservative 0.102, Central 0.234, Upper 0.367)
nfix_b 0.524            ! Second term in N fixation eqn (Conservative 0.524, Central -0.172, Upper -0.754)
nrelocfrac 0.5            ! Fraction of N retranslocated prior to leaf and root shedding


!///////////////////////////////////////////////////////////////////////////////
! ARCTIC AND WETLAND SWITCHES
!///////////////////////////////////////////////////////////////////////////////

!iftwolayersoil 0        ! Use the original LPJ-GUESS v4 two layer soil and snow scheme, or not (0, by default). 
                ! Of the switches below, iforganicsoilproperties, ifcarbonfreeze and 
                ! ifmultilayersnow must all be 0 if iftwolayersoil = 1
                ! Furthermore, run_peatland must be 0 when using the two layer soil, and 
                ! rootdistribution must be "fixed"

!ifmultilayersnow 1         ! 0 is the old, single-layer scheme. 1 by default (applies to all stand types)
!iforganicsoilproperties 0    ! Whether to update physical soil properties using soil carbon content 
                ! (applies only to non peatland, mineral stands not classified as organic)
!ifcarbonfreeze 1        ! Whether to allow some decomposition below 0 degC in upland soils (1 by default), or not (0)

! WETLAND SWITCHES (no effect when run_peatland 0)
!ifinundationstress 1        ! Whether to reduce daily GPP if there's inundation on peatlands (1), or not (0)
!wetland_runon 0            ! Extra daily water input to (>0), or output from (<0), wetlands (mm/day). 
                ! 0 by default, non-zero for site specific studies.
!ifmethane 0            ! Whether to run the methane model and calculate methane fluxes
!ifsaturatewetlands 0        ! Whether to take water from runoff to saturate low latitide wetlands (1), or not (0)


!///////////////////////////////////////////////////////////////////////////////
! SERIALIZATION SETTINGS
!///////////////////////////////////////////////////////////////////////////////

!state_year 500                  ! Year to save/start state file (no setting = after spinup)
restart 0                       ! Whether to start from a state file
save_state 0                     ! Whether to save a state file
state_path "./state/"            ! Directory to put state files in


!///////////////////////////////////////////////////////////////////////////////
! LANDCOVER PARAMETERS
!///////////////////////////////////////////////////////////////////////////////

! All landcover-related settings are in landcover.ins (in the ozflux directory,
! NOT the one in the data directory!!!).
!
! In the committed version of the file, run_landcover is set to 0, so this
! should have no effect by default.
import "landcover.ins"

!///////////////////////////////////////////////////////////////////////////////
! PFT parameters
!///////////////////////////////////////////////////////////////////////////////

!import "pft_common.ins"

!import "trees.ins"
!import "shrubberies.ins"
!import "c3g.ins"
!import "c4g.ins"

! for Warra only 
! import "pfts_jamey.ins"
!import "warra_pfts.ins"
! also, comment out pft_commons.ins

import "pft_dave.ins"

! Uncomment this (and comment out all other pft .ins files) to use the standard
! (global) pfts. This should always be done when using trunk allocation.
!import "pft_global.ins"
