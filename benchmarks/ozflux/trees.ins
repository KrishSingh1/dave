!///////////////////////////////////////////////////////////////////////////////
! Tree PFTs
!///////////////////////////////////////////////////////////////////////////////

pft "BNE" (

	! Boreal needleleaved evergreen tree

	include 0
	tree
	needleleaved
	shade_tolerant
	evergreen
	boreal
	leaflong 3
	turnover_leaf 0.33
	tcmin_surv -31
	tcmin_est -30
	tcmax_est -1
	twmin_est 5
	gdd5min_est 500
	longevity 500
	fireresist 0.3
	eps_iso 8.0
	seas_iso 0
	eps_mon 1.7 0.7 0.4 0.24 0.24 0.2 0.84 0.26 0.22
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5
)

pft "BINE" (

	! Boreal needleleaved evergreen tree

