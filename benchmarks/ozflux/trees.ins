pft "TrBR" (

	! Tropical broadleaved raingreen tree

	include 1
	tree
	broadleaved
	shade_intolerant
	tropical
	phenology "raingreen"
	fnstorage 0.15
	leaflong 0.5
	turnover_leaf 1
