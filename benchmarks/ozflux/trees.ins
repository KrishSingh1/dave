)

pft "IBS" (

	! Shade-intolerant broadleaved summergreen tree

	include 0
	tree
	broadleaved
	shade_intolerant
	summergreen
	boreal
	tcmin_surv -30
	tcmin_est -30
	tcmax_est 7
	twmin_est -1000  !no limit
