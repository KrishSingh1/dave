)

pft "ASM" (

	! Alice Springs Mulga - acacia aneura, based on TeBE with added hydraulic, vcmax and sla parameters

	include 0
	tree
	broadleaved
	shade_intolerant
	evergreen
	temperate
	leaflong 2
	turnover_leaf 0.5
	tcmin_surv -1
	tcmin_est 0
	tcmax_est 30
	twmin_est 5
	gdd5min_est 2000
	longevity 300 		! from TH 2010-04-07 was 350 AA
	fireresist 0.3
	eps_iso 24.0
	seas_iso 0
	eps_mon 0.74 0.2 0.2 0.09 0.13 0.08 0.02 0.08 0.08
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5

	! hydraulic traits
	wooddens 388  ! value for Acacia aneura from Peters (2021)
	kmax 1.5 ! maximum hydraulic conductance (mmol/m2/s/MPa) - to be tuned
	stom_clos -6.72   ! value for Acacia aneura from Peters (2021)
	p50 -10.37   ! value for Acacia aneura from Peters (2021)
	p88 -11.59   ! value for Acacia aneura from Peters (2021)
	nx 0.5  ! water holding capacity of the xylem conduits plus nonconducting tissues (unitless)
	g1x 4  ! g1 at leaf water potential = -0.3 Mpa (Zhou et al. 2014) - using value for driest species in that paper
	b1z 1  ! not used
	gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))

	vcmax_25 0.000020 ! see ST7 (supp table 2) from Bloomfield et al. (2018)
	sla 7.19 ! see ST6 (supp table 2) from Bloomfield et al. (2018)

	respcoeff 0.3 ! testing decreased respiration to increase productivity, suspect this is otherwise too high at dry sites because it doesn't account for soil moisture
)

pft "WAR_ov" (

	! Warra overstory, eucalyptus obliqua, based on TeBE with added hydraulic, vcmax and sla parameters

	include 1
	tree
	broadleaved
	shade_intolerant
	evergreen
	temperate
	leaflong 2
	turnover_leaf 0.5
	tcmin_surv -1
	tcmin_est 0
	tcmax_est 18.8
	twmin_est 5
	gdd5min_est 1000
	longevity 300 		! from TH 2010-04-07 was 350 AA
	fireresist 0.3
	eps_iso 24.0
	seas_iso 0
	eps_mon 0.74 0.2 0.2 0.09 0.13 0.08 0.02 0.08 0.08
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5

	! hydraulic traits
	wooddens 300  ! Peters et al (2021)
	kmax 5 ! maximum hydraulic conductance (mmol/m2/s/MPa) - to be tuned
	stom_clos -1.5   ! Peters et al (2021)
	p50 -3.03   ! Peters et al (2021)
	p88 -3.84   ! Peters et al (2021)
	nx 0.5  ! water holding capacity of the xylem conduits plus nonconducting tissues (unitless)
	g1x 2  ! g1 at leaf water potential = -0.3 Mpa (Zhou et al. 2014) 
	b1z 1  ! not used
	gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))

	vcmax_25 0.000069 ! see ST7 (supp table 2) from Bloomfield et al. (2018)
	sla 10.05 ! see ST6 (supp table 2) from Bloomfield et al. (2018)
)

pft "WAR_un" (

	! Warra understory, mixed, based on TeBE with added hydraulic, vcmax and sla parameters

	include 1
	tree
	crownarea_max 10 ! from group 'shrub'
	broadleaved
	shade_tolerant
	evergreen
	temperate
	leaflong 2
	turnover_leaf 0.5
	tcmin_surv -1
	tcmin_est 0
	tcmax_est 18.8
	twmin_est 5
	gdd5min_est 1000
	longevity 300 		! from TH 2010-04-07 was 350 AA
	fireresist 0.3
	eps_iso 24.0
	seas_iso 0
	eps_mon 0.74 0.2 0.2 0.09 0.13 0.08 0.02 0.08 0.08
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5

	ltor_max 0.9
	k_allom1 100	! from group 'shrub'
	k_allom2 5		! from group 'shrub'
	k_allom3 0.67 	! from group 'shrub'
	k_rp 1.6		! from group 'shrub'

	! hydraulic traits
	wooddens 279  ! Peters et al (2021) - weighted average of understory species
	kmax 5 ! maximum hydraulic conductance (mmol/m2/s/MPa) - to be tuned
	stom_clos -1.5   ! Peters et al (2021)
	p50 -3.41   ! Peters et al (2021)
	p88 -5.10   ! Peters et al (2021)
	nx 0.5  ! water holding capacity of the xylem conduits plus nonconducting tissues (unitless)
	g1x 2  ! g1 at leaf water potential = -0.3 Mpa (Zhou et al. 2014) 
	b1z 1  ! not used
	gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))

	vcmax_25 0.000044 ! see ST7 (supp table 2) from Bloomfield et al. (2018)
	sla 16.0 ! see ST6 (supp table 2) from Bloomfield et al. (2018)
)

pft "Calp" (

	! Calperum mallees, eucalyptus socialis and dumosa, based on TeBE with added hydraulic, vcmax and sla parameters

	include 0
	tree
	broadleaved
	shade_intolerant
	evergreen
	temperate
	leaflong 2.44 ! See Wright et al (2002)
	turnover_leaf 0.41
	tcmin_surv -1
	tcmin_est 0
	tcmax_est 30
	twmin_est 5
	gdd5min_est 2000
	longevity 300 		! from TH 2010-04-07 was 350 AA
	fireresist 0.3
	eps_iso 24.0
	seas_iso 0
	eps_mon 0.74 0.2 0.2 0.09 0.13 0.08 0.02 0.08 0.08
	storfrac_mon 0.4 0.8 0.8 0.4 0.4 0.5 0.8 0.2 0.5

	! hydraulic traits
	wooddens 400  ! Peters et al (2021) - average of euc species
	kmax 1.5 ! maximum hydraulic conductance (mmol/m2/s/MPa) - to be tuned
	stom_clos -3.5   ! Point of stomatal closure, usually p12 or turgor loss point (MPa)
	p50 -7.47   ! Peters et al (2021) - average of euc species, -7.47
	p88 -10.06   ! Peters et al (2021) - average of euc species
	nx 0.5  ! water holding capacity of the xylem conduits plus nonconducting tissues (unitless), not used
	g1x 3  !  at leaf water potential = -0.3 Mpa (Zhou et al. 2014) 
	b1z 1  ! not used
	gcutic 0.0005 ! cuticular conductance (about 10% of g0, dark stomatal conductance, Duursma et al. (2019))

	vcmax_25 0.000080 ! see ST7 (supp table 2) from Bloomfield et al. (2018)
	sla 5.24 ! see ST6 (supp table 2) from Bloomfield et al. (2018)

	respcoeff 0.3 ! testing decreased respiration to increase productivity, suspect this is otherwise too high at dry sites because it doesn't account for soil moisture
)
