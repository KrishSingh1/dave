! This file contains paths to forcing data used by the benchmarks

param "file_co2"      (str "/data/benchmark_data/2019-04-29/co2/co2_1901_2018.txt")
param "file_cru"      (str "/data/benchmark_data/2019-04-29/cru_ncep/cruncep_1901_2017.bin")
param "file_cru_misc" (str "/data/benchmark_data/2019-04-29/cru_ncep/cruncep_1901_2017misc.bin")

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
param "file_ndep"     (str "/data/benchmark_data/2019-04-29/ndep/GlobalNitrogenDeposition.bin")

! Soil map
param "file_soildata"  (str "/data/benchmark_data/2019-04-29/soil/soilmap_center_interpolated.dat")
!param "file_soildata" (str "/data/benchmark_data/2019-04-29/soil/fao_soilcodes.txt")

! Location of EUROFLUX data
param "flux_dir"      (str "/data/benchmark_data/2013_02_12/euroflux/")

! Location of subset of WATCH diurnal data
param "watch_dir"     (str "/data/benchmark_data/2013_02_12/watch_subset")
