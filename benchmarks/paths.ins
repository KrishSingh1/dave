! This file contains paths to forcing data used by the benchmarks

param "file_co2"      (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2019-04-29/co2/co2_1901-2018.txt")
param "file_cru"      (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2019-04-29/cru_ncep/cruncep_1901_2017.bin")
param "file_cru_misc" (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2019-04-29/cru_ncep/cruncep_1901_2017misc.bin")

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
param "file_ndep"     (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2015_12_14/ndep/for_cruncep/GlobalNitrogenDeposition.bin")

! SIMFIRE-BLAZE related files  
param "file_simfire"  (str "/lunarc/nobackup/users/x_larni/FAST_ARCHIVES/SimfireInput.bin")                                            
	      
! Soil map
!CLNAWTLparam "file_soildata" (str "/data/benchmark_data/2019-03-20/soil/soilmap_center_interpolated.dat")
!CLNAWTL!param "file_soildata" (str "/data/benchmark_data/2019-03-20/soil/fao_soilcodes.txt")
!param "file_soildata" (str "/data/benchmark_data/2019-03-20/soil/fao_soilcodes.txt")
param "file_soildata" (str "/home/x_larni/TMP/fao_soilcodes.txt")

! Location of EUROFLUX data
param "flux_dir"      (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2013_02_12/euroflux/")

! Location of subset of WATCH diurnal data
param "watch_dir"     (str "/lunarc/nobackup/projects/lpjguess/data/benchmark_data/2013_02_12/watch_subset")

rootdistribution "fixed"                                                                                        
                                                                                                               
iftwolayersoil 1                                                                                                
ifmultilayersnow 0                                                                                             
ifinundationstress 0                                                                                           
ifcarbonfreeze 0                                                                                                
