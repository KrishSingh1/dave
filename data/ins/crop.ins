file_yield "yield.out"
file_yield1 "yield1.out"
file_yield2 "yield2.out"
file_sdate1 "sdate1.out"
file_sdate2 "sdate2.out"
file_hdate1 "hdate1.out"
file_hdate2 "hdate2.out"
file_lgp "lgp.out"
file_phu "phu.out"
file_fphu "fphu.out"
file_fhi "fhi.out"
file_irrigation "irrigation.out"
file_seasonality "seasonality.out"
file_cmass_cropland ""
file_cmass_pasture ""
file_cmass_natural "cmass_natural.out"
file_cmass_forest "cmass_forest.out"
file_anpp_cropland ""
file_anpp_pasture ""
file_anpp_natural "anpp_natural.out"
file_anpp_forest "anpp_forest.out"
file_dens_natural "dens_natural.out"
file_dens_forest "dens_forest.out"
file_cflux_cropland "cflux_cropland.out"
file_cflux_pasture "cflux_pasture.out"
file_cflux_natural "cflux_natural.out"
file_cflux_forest "cflux_forest.out"
file_cpool_cropland "cpool_cropland.out"
file_cpool_pasture "cpool_pasture.out"
file_cpool_natural "cpool_natural.out"
file_cpool_forest "cpool_forest.out"
file_nflux_cropland "nflux_cropland.out"
file_nflux_pasture "nflux_pasture.out"
file_nflux_natural "nflux_natural.out"
file_nflux_forest "nflux_forest.out"
file_npool_cropland "npool_cropland.out"
file_npool_pasture "npool_pasture.out"
file_npool_natural "npool_natural.out"
file_npool_forest "npool_forest.out"

!///////////////////////////////////////////////////////////////////////////////////////
!// RUN PARAMETERS AND OPTIONS 
!

npatch_secondarystand 5		! number of replicate patches to simulate in secondary stands
reduce_all_stands 0		! Whether to reduce equal percentage of all stands of a stand type at land cover change
age_limit_reduce 0		! Minimum age of stands to reduce at land cover change

!!!!!!!!!!!! landcover parameters !!!!!!!!!!!!!!					

run_landcover 1        ! whether to use (and change) landcover fractions (1) or not (0)						

run_urban 0	      ! whether to simulate barren land (1) or not (0)	
run_crop 1	      ! whether to simulate crop vegetation (1) or not (0)
run_forest 0	      ! whether to simulate managed forest (1) or not (0)
run_pasture 1	      ! whether to simulate pasture (1) or not (0)
run_natural 1	      ! whether to simulate natural vegetation (1) or not (0)
run_peatland 0	      ! whether to simulate peatland (1) or not (0)
run_barren 0	      ! whether to simulate barren land (1) or not (0)

minimizecftlist 0	! Checks st fraction file for st:s with fractions>0.0 at any time or place; other st:s are exluded from the stlist
			! Only active pft:s in these st:s are kept in the pftlist
cftfrac_fixed 0       	! whether to use fixed CFT fractions (all active crop pft:s have equal area) (1) or read CFT fractions from a file (0)
frac_fixed_default_crops 0 ! whether to use all active crop stand types (0) or only stand types with suitable rainfed crops (based on crop pft tb and gridcell latitude) (1) when using fixed crop fractions
!nyears_cropland_ramp 300 ! Number of years to increase cropland fraction linearly from 0 to first year's value

ifslowharvestpool 1	! If a slow harvested product pool is included in patchpft.
ifintercropgrass 1	! Whether to grow grass as cover crop between growing periods

printseparatestands 0	! Whether to print multiple stands within a land cover type (except cropland) separately
!forceautumnsowing 0	! Whether autumn sowing is forced independent of climate
ifcalcdynamic_phu 1	! Whether to calculate dynamic potential heat units
ifdyn_phu_limit 0	! Whether to limit dynamic phu calculation to a period specified by nyear_dyn_phu
nyear_dyn_phu 50	! Number of years to calculate dynamic phu if dynamic_phu_limit is 1
iftillage 0		! Whether to simulate tillage by increasing soil respiration
gross_land_transfer 0	! Whether to use gross land transfer: simulate gross lcc (1); read landcover transfer matrix input file (2); read stand type transfer matrix input file (3), or not (0)
ifprimary_lc_transfer 0	! Whether to use primary/secondary land transition info in landcover transfer input file (1). or not (0)
transfer_level 1	! Pooling level of land cover transitions; 0: one big pool; 1: land cover-level; 2: stand type-level
iftransfer_to_new_stand 0	! Whether to create new stands in transfer_to_new_stand() according to the rules in copy_stand_type()


!///////////////////////////////////////////////////////////////////////////////////////

!// PARAMETERS FOR STAND TYPES

group "common_stand" (

	intercrop "nointercrop"
	rotation 0
	naturalveg "none"
	restrictpfts 0		! Use all pft:s defined for a land cover (pft parameter landcover)
)

group "crop_stand" (

	landcover "cropland"
	rotation 1		! Only one crop
	hydrology1 "rainfed"
	intercrop "naturalgrass" ! Use natural grass pft:s as covercrop
	restrictpfts 1		! Use only pft:s specified in stand type
)

st "Peatland" (

	common_stand
	stinclude 1
	landcover "peatland"
)

st "Natural" (

	common_stand
	stinclude 1
	landcover "natural"
)

st "Pasture" (

	common_stand
	stinclude 1
	landcover "pasture"
!	naturalveg "grassonly"	! Use natural grass pft:s

)

st "Forest" (

	common_stand
	stinclude 1
	landcover "forest"
	naturalveg "all"	! Use natural pft:s
)

st "Barren" (

	common_stand
	stinclude 1
	landcover "barren"
	naturalveg "none"
)

st "CC3G" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC3G"
)

st "CC4G" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC4G"
)

st "TeWW" (
	! Example of settings for crop rotation

	crop_stand
	stinclude 1

	rotation 1		! Change according to no. of crops in rotation (if 1, crop2 etc. will be ignored)
	firstrotyear 1901	! First years of rotation scheme

	crop1 "TeWW"		! First crop in rotation
	hydrology1 "rainfed"	! Rainfed crop
	nfert1 50		! Fixed nitrogen fertilisation
!	sdate1 55		! Fixed sowing date
!	hdate1 145		! Fixed (approximate) harvest date
	crop2 "TeCo"		! Second crop in rotation
	hydrology2 "irrigated"	! Irrigated crop
	nfert2 0
!	sdate2 160
!	hdate2 300
	crop3 "TeCo"		! Third crop in rotation (needs to be set also for fallow)
	fallow3 1		! One year of fallow with natural grass
)

st "TrRi" (

	crop_stand
	stinclude 1
	crop1 "TrRi"
)

st "TeCo" (

	crop_stand
	stinclude 1
	crop1 "TeCo"
)

st "TrMi" (

	crop_stand
	stinclude 1
	crop1 "TrMi"
)

st "TePu" (

