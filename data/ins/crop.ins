!///////////////////////////////////////////////////////////////////////////////////////
!// CROP-SPECIFIC ADDITIONS TO LPJ-GUESS INSTRUCTION SCRIPT
!// Mats Lindeskog 2012-09-18
!///////////////////////////////////////////////////////////////////////////////////////

file_yield "yield.out"
file_yield1 "yield1.out"
file_yield2 "yield2.out"
file_sdate1 "sdate1.out"
file_sdate2 "sdate2.out"
file_hdate1 "hdate1.out"
file_hdate2 "hdate2.out"
file_lgp "lgp.out"
file_phu "phu.out"
file_fphu "fphu.out"
file_fhi "fhi.out"
file_irrigation "irrigation.out"
file_seasonality "seasonality.out"
file_cflux_cropland "cflux_cropland.out"
file_cflux_pasture "cflux_pasture.out"
file_cflux_natural "cflux_natural.out"
file_cflux_forest "cflux_forest.out"
file_cpool_cropland "cpool_cropland.out"
file_cpool_pasture "cpool_pasture.out"
file_cpool_natural "cpool_natural.out"
file_cpool_forest "cpool_forest.out"

!!!!!!!!!!!! landcover parameters !!!!!!!!!!!!!!					

run_landcover 1        ! whether to use (and change) landcover fractions (1) or not (0)						

run_urban 0	      ! whether to simulate barren land (1) or not (0)	
run_crop 1	      ! whether to simulate crop vegetation (1) or not (0)
run_forest 0	      ! whether to simulate managed forest (1) or not (0)
run_pasture 1	      ! whether to simulate pasture (1) or not (0)
run_natural 1	      ! whether to simulate natural vegetation (1) or not (0)
run_peatland 0	      ! whether to simulate peatland (1) or not (0)

minimizecftlist 0	! Checks cft fraction file for cft:s with fractions>0.0 at any time or place; if cftfrac_fixed is 1, this option is not functional.
cftfrac_fixed 0       	! whether to force CFT % (1) or just read CFT file (0) ; all active crop pft:s have equal area

ifslowharvestpool 1	! If a slow harvested product pool is included in patchpft.
ifintercropgrass 1	! Whether to grow grass as cover crop between growing periods

forcesowingdates 0	! Whether to read sowing dates from an input file
forceharvestdates 0	! Whether to read harvest dates from an input file	
readNfert 0		! Whether to read nitrogen fertilization from input file
printseparatestands 0	! Whether to print multiple stands within a land cover type (except cropland) separately
!forceautumnsowing 0	
ifcalcdynamic_phu 1	! Whether to calculate dynamic potential heat units
ifdyn_phu_limit 0	! Whether to limit dynamic phu calculation to a period specified by nyear_dyn_phu
nyear_dyn_phu 50	! Number of years to calculate dynamic phu if dynamic_phu_limit is 1

!///////////////////////////////////////////////////////////////////////////////////////

!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS

pft "C3G_pasture" (

	! Cool (C3) grass

	include 1
	grass
	pathway "c3"
	respcoeff 1.0
	pstemp_min -5
	pstemp_low 10
	pstemp_high 30
	pstemp_max 45
	tcmin_surv -1000	!no limit
	tcmin_est -1000 	!no limit
	tcmax_est 1000  	!no limit
	twmin_est -1000 	!no limit
	gdd5min_est 0   	!no limit
	eps_iso 16.0
	seas_iso 1
	eps_mon 1.6
	storfrac_mon 0.5

	harv_eff 0.5			! old value; intensive grazing: 90% grazed, 25-60 % returned to soil as faeces (0.36-0.675 removed, 0.5 OK average)
	res_outtake 0.0			! not used by crop grass

	landcover "pasture"	! Grows only in pasture
)

pft "C4G_pasture" (

	! Warm (C4) grass

	include 1
	grass
	pathway "c4"
	respcoeff 0.15
	pstemp_min 6
	pstemp_low 20
	pstemp_high 45
	pstemp_max 55
	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000  !no limit
	twmin_est -1000 !no limit
	gdd5min_est 0   !no limit
	eps_iso 8.0
	seas_iso 0
	eps_mon 2.4
	storfrac_mon 0.5

	harv_eff 0.5			! old value; intensive grazing: 90% grazed, 25-60 % returned to soil as faeces (0.36-0.675 removed, 0.5 OK average)
	res_outtake 0.0			! not used by crop grass

	landcover "pasture"	! Grows only in pasture
)

group "crop" (

	! Parameter common to all crops

	include 1
	phenology "cropgreen"
	rootdist 0.9 0.1  !Sitch et al give 0.9 0.1	Fraction of fine roots in the upper and lower soil layers.
!	sla 41.1      ! value overridden if "ifcalcsla 1" specified above
	fireresist 0.5  ! 9.11.02  Alb (originally fireresist=1)						!Included in grass
	respcoeff 1   ! Sitch et al 2001 specify 1.2				!090910 for cohort /ML; NB: guess2.1 grass value is 2.0. Keep 1.0 for crops ??
	gmin 0.5
	turnover_leaf 1
	turnover_root 0.7
	intc 0.01
	drought_tolerance 0.01
	leaflong 1			! Leaf longevity (years)
	frootstart 0.40
	frootend 0.20

	tcmin_surv -1000 ! limit not implemented					! value not relevant for non-autumn-sown crops
	tcmin_est -1000  ! limit not implemented					! value not relevant for non-autumn-sown crops
	tcmax_est 1000  	!no limit	
	twmin_est -1000  ! limit not implemented
	gdd5min_est 0   	!no limit; previously initiated to 1000 in initpft()

	parff_min 0	!110302: true crops, reset to 1000000 for crop grass

	landcover "cropland"
!	intercrop "nointercrop"		! ML CFT
	intercrop "naturalgrass"	! ML CFT
	ifsdcalc 0
	ifsdtemp 0
	ifsdautumn 0
	ifsdspring 0
	ifsdprec 0
	tempautumn 12
	tempspring 12

	harv_eff 0.9		! Part of harvestable organs actually harvested
	harvest_slow_frac 0	! Part of harvest that goes into patchpft.harvested_products_slow, the rest goes into fluxes.acflux_harvest
	turnover_harv_prod 1 	! Turnover rate for long-lived harvested products (wood) : 1-year turnover time for crops
	res_outtake 0.75	! Part of residues after harvest removed from stand; goes into fluxes.acflux_harvest
	aboveground_ho 1	! 
	isintercropgrass 0
!!	forcesowingdate 0
!!	forceharvestdate 1
!	forceautumnsowing 0
	readNfert 1
)

pft "CC3G" (

	! Cool (C3) grass   n?11 (pft.id 10)

	grass
	crop
	phenology "any"
!	include 1
	cftid 0	
	pathway "c3"
	phenology "any"	
	pstemp_min -5						! C3G-values 090910/ML
	pstemp_low 10
	pstemp_high 30
	pstemp_max 45
	tcmin_surv -1000 ! limit not implemented
	tcmin_est -1000  ! limit not implemented
	tcmax_est 1000  	!no limit			! as in C3G 090910/ML
	twmin_est -1000  ! limit not implemented
	gdd5min_est 0    ! limit not implemented

	laimax 4
	intercrop "nointercrop"		! ML CFT
	isintercropgrass 0
	harv_eff 0.5
	harv_eff_ic 0.0
	leaflong 1			! as in crop
	turnover_leaf 1			! as in crop
	turnover_root 0.7		! as in crop
	phengdd5ramp 100
	rootdist 0.9 0.1		! as in crop
	gmin 0.5			! as in crop

	drought_tolerance 0.01		! as in crop
	intc 0.01			! as in crop

	respcoeff 1.0			! as in crop (general grass value 2.0)
	fireresist 0.5			! as in crop (c3_gr 1.0)
	parff_min 1000000		! ThomasH 2000000 ! Changed from 2500000 on April 10, 2006; c3_gr 2000000
)

pft "CC4G" (

	! Warm (C4) grass

	grass
	crop
	parff_min 1000000
!	include 0
	cftid 1			
	pathway "c4"

	phenology "any"	
	leaflong 1			! as in crop
	turnover_leaf 1			! as in crop

	phengdd5ramp 100
	rootdist 0.9 0.1		! as in crop
	gmin 0.5			! as in crop
	pstemp_min 6						
	pstemp_low 20
	pstemp_high 45
	pstemp_max 55
	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000			! limit not implemented
	twmin_est -1000			! limit not implemented  ! limit not implemented
	gdd5min_est 0			! limit not implemented
	parff_min 1000000		! ThomasH 2000000 ! Changed from 2500000 on April 10, 2006
	intc 0.01			! as in crop
	drought_tolerance 0.01		! as in crop

	respcoeff 0.15			! guess2008 value (c4_gr 2.0)
	turnover_root 0.7		! as in crop, (c4_gr 0.5)
	fireresist 0.5			! as in crop, (c4_gr 1.0)

	intercrop "nointercrop"		
	laimax 4	
	isintercropgrass 0
	harv_eff 0.5			! old value; intensive grazing: 90% grazed, 25-60 % returned to soil as faeces (0.36-0.675 removed, 0.5 OK average)
	harv_eff_ic 0.0
	res_outtake 0.0			! not used by crop grass
)

pft "TeWW" (

	! Winter cereals, Triticum spp. (wheat), Hordeum vulgare (barley), Secale cereale (rye), Avena sativa (oat)
	
	grass
	crop
!	include 1
	cftid 2			
	pathway "c3"
	phengdd5ramp 500
	pstemp_min -5	
	pstemp_low 10	
	pstemp_high 30	
	pstemp_max 45	

	sdatenh 330	! for initialization, otherwise calculated to be adapted to climate and precocity
	sdatesh 150	! idem
	tb 0		! base temperature
	trg 12		! temperatures have a vernalizing effect until trg
	pvd 0		! not implemented since calculated to be adapted to climate
	psens 0.5		! temporary, should be adapted to climate and precocity ?
	pb 8		! not yet implemented
	ps 20		! not yet implemented
	phu 2900	! not implemented since calculated to be adapted to climate
	hlimitdatenh 269! for initialization
	hlimitdatesh 89	! idem

!!	fphuc 0.05							! SWAT winter wheat values
!!	flaimaxc 0.05
!!	fphuk 0.45
!!	flaimaxk 0.95
	fphusen 0.7							! SWAT 0.9

	shapesenescencenorm 1
	flaimaxharvest 0
!!	laimax 6	! 									; increase ? 10 in Eslami et al 2006
	hiopt 0.5	! FAO/IIASA AEZ				
	himin 0.2						

	ifsdcalc 1
	ifsdtemp 1
	ifsdautumn 1
	ifsdspring 1
	tempautumn 12
	tempspring 5
)

pft "TrRi" (

	! rice, Oryza sativa

	grass
	crop
!	include 0
	cftid 3			
	pathway "c3"
	pstemp_min -5	
	pstemp_low 10	
	pstemp_high 30	
	pstemp_max 45	

	sdatenh 120	! for initialization, otherwise calculated, possibly several growing seasons in one year
	sdatesh 300	! idem	new value 1004 /ML
	tb 10		! base temperature
	trg 10		! temperatures have a vernalizing effect until trg
	pvd 0
	psens 1		! temporary, should be adapted to climate and precocity ?
	pb 24		! not yet implemented
	ps 0		! not yet implemented
	phu 1800
	hlimitdatenh 60		! for initialization
	hlimitdatesh 240	! for initialization

!!	fphuc 0.1		! NEW 100413
!!	flaimaxc 0.05		! NEW 100413
!!	fphuk 0.5		! NEW 100413
!!	flaimaxk 0.95
	fphusen 0.80		! SWAT 0.9

	shapesenescencenorm 1
	flaimaxharvest 0	
!!	laimax 5	! SWAT					; Increase to 10-12 (Peng 2000), 12.7 (Kiniry 2001)
	hiopt 0.5
	himin 0.25

	intercrop "nointercrop"	
	ifsdcalc 1
	tempspring 18
)

