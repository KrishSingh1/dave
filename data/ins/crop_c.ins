!///////////////////////////////////////////////////////////////////////////////////////
!// CARBON-ONLY CROP ADDITIONS TO LPJ-GUESS INSTRUCTION SCRIPT
!// Mats Lindeskog 2015-10-14
!///////////////////////////////////////////////////////////////////////////////////////

import "crop.ins"

!///////////////////////////////////////////////////////////////////////////////////////
!// RUN PARAMETERS AND OPTIONS 
!

ifnlim 0

!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR STAND TYPES

st "CC3G" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC3G"
)

st "CC4G" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC4G"
)


st "TeWW" (
	! Example of settings for crop rotation

	crop_stand
	stinclude 1

	rotation 1		! Change according to no. of crops in rotation (if 1, crop2 etc. will be ignored)
	firstrotyear 1901	! First years of rotation scheme

	crop1 "TeWW"		! First crop in rotation
	hydrology1 "rainfed"	! Rainfed crop
	nfert1 50		! Fixed nitrogen fertilisation
!	sdate1 55		! Fixed sowing date
!	hdate1 145		! Fixed (approximate) harvest date
	crop2 "TeCo"		! Second crop in rotation
	hydrology2 "irrigated"	! Irrigated crop
	nfert2 0
!	sdate2 160
!	hdate2 300
	crop3 "TeCo"		! Third crop in rotation (needs to be set also for fallow)
	fallow3 1		! One year of fallow with natural grass
)

st "TrRi" (

	crop_stand
	stinclude 1
	crop1 "TrRi"
)

st "TeCo" (

	crop_stand
	stinclude 1
	crop1 "TeCo"
)

st "TrMi" (

	crop_stand
	stinclude 1
	crop1 "TrMi"
)

st "TePu" (

	crop_stand
	stinclude 1
	crop1 "TePu"
)

st "TeSb" (

	crop_stand
	stinclude 1
	crop1 "TeSb"
)


st "TrMa" (

	crop_stand
	stinclude 1
	crop1 "TrMa"
)


st "TeSf" (

	crop_stand
	stinclude 1
	crop1 "TeSf"
)


st "TeSo" (

	crop_stand
	stinclude 1
	crop1 "TeSo"
)


st "TrPe" (

	crop_stand
	stinclude 1
	crop1 "TrPe"
)


st "TeRa" (

	crop_stand
	stinclude 1
	crop1 "TeRa"
)

st "CC3Girr" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC3Girr"
	hydrology1 "irrigated"
)

st "CC4Girr" (

	crop_stand
	stinclude 1
	intercrop "nointercrop"
	crop1 "CC4Girr"
	hydrology1 "irrigated"
)

st "TeWWirr" (

	crop_stand
	stinclude 1
	crop1 "TeWWirr"
	hydrology1 "irrigated"
)

st "TrRiirr" (

	crop_stand
	stinclude 1

	rotation 1
	rottime 1
	multicrop 0
	firstrotyear 1901
	crop1 "TrRiirr"
	hydrology1 "irrigated"
)

st "TeCoirr" (

	crop_stand
	stinclude 1
	crop1 "TeCoirr"
	hydrology1 "irrigated"
)

st "TrMiirr" (

	crop_stand
	stinclude 1
	crop1 "TrMiirr"
	hydrology1 "irrigated"
)

st "TePuirr" (

	crop_stand
	stinclude 1
	crop1 "TePuirr"
	hydrology1 "irrigated"
)

st "TeSbirr" (

	crop_stand
	stinclude 1
	crop1 "TeSbirr"
	hydrology1 "irrigated"
)


st "TrMairr" (

	crop_stand
	stinclude 1
	crop1 "TrMairr"
	hydrology1 "irrigated"
)


st "TeSfirr" (

	crop_stand
	stinclude 1
	crop1 "TeSfirr"
	hydrology1 "irrigated"
)


st "TeSoirr" (

	crop_stand
	stinclude 1
	crop1 "TeSoirr"
	hydrology1 "irrigated"
)


st "TrPeirr" (

	crop_stand
	stinclude 1
	crop1 "TrPeirr"
	hydrology1 "irrigated"
)


st "TeRairr" (

	crop_stand
	stinclude 1
	crop1 "TeRairr"
	hydrology1 "irrigated"
)


!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings

pft "CC3G" (
	CC3G
	include 1
)

pft "CC4G" (
	CC4G
	include 1
)

pft "TeWW" (
	TeW
	include 1
)

pft "TrRi" (
	TrRi
	include 1
)

pft "TeCo" (
	TeCo
	include 1
)

pft "TrMi" (
	TrMi
	include 1
)

pft "TePu" (
	TePu
	include 1
)

pft "TeSb" (
	TeSb
	include 1
)

pft "TrMa" (
	TrMa
	include 1
)

pft "TeSf" (
	TeSf
	include 1	
)

pft "TeSo" (
	TeSo
	include 1	
)

pft "TrPe" (
	TrPe
	include 1
)

pft "TeRa" (
	TeRa
	include 1
)


! Irrigated pft:s are convenient in output files, but technically not necessary

pft "CC3Girr" (
	CC3G
	include 1
)

pft "CC4Girr" (
	CC4G
	include 1	
)

pft "TeWWirr" (
	TeW
	include 1
)

pft "TrRiirr" (
	TrRi
	include 1
)

pft "TeCoirr" (
	TeCo
	include 1	
)

pft "TrMiirr" (
	TrMi
	include 1	
)

pft "TePuirr" (
	TePu
	include 1	
)

pft "TeSbirr" (
	TeSb
	include 1	
)

pft "TrMairr" (
	TrMa
	include 1	
)

pft "TeSfirr" (
	TeSf
	include 1	
)

pft "TeSoirr" (
	TeSo
	include 1
)

pft "TrPeirr" (
	TrPe
	include 1
)

pft "TeRairr" (
	TeRa
	include 1
)

pft "CC3G_ic" (
	C3G
	landcover "cropland"
	laimax 4
	isintercropgrass 1
	harv_eff 0.0
	harv_eff_ic 0.0
	res_outtake 0.0		! not used by crop grass
	leaflong 1		! as in crop
)

pft "CC4G_ic" (
	C4G
	landcover "cropland"
	laimax 4
	isintercropgrass 1
	harv_eff 0.0
	harv_eff_ic 0.0
	res_outtake 0.0		! not used by crop grass
	leaflong 1		! as in crop
)
