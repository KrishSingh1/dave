!///////////////////////////////////////////////////////////////////////////////////////
! Forcing Data & gridlists
!
! Atmospheric CO2 content (ppmv)
! (used only by guessio.cpp)
param "co2" (num 340)

param "file_temp" (str "data/env/tmp30_21.grd")	!temperature
param "file_prec" (str "data/env/prc30_21.grd")	!precipitation
param "file_sun" (str "data/env/clo30_21.grd")	!sunshine

! Path to LPJ soil code file
! You may need to specify the full pathname (including directory) here
param "file_soil" (str "data/env/soils_lpj.dat")
!///////////////////////////////////////////////////////////////////////////////////////

nyear 100				! number of years to run the model after spinup (demo module only)
