!
! Instruction file with European species to be used with the 
! CF I/O module.
!
! Make sure to start LPJ-GUESS with -input cf when using this
! instruction file.
!

import "europe.ins"

coordinates_precision 2

!///////////////////////////////////////////////////////////////////////////////////////
! Forcing Data & gridlists
!

param "file_gridlist" (str "gridlist.txt")

param "file_co2"      (str "c:/co2/co2_1901-2006.txt")
param "file_cru"      (str "c:/cru/cru_1901_2006.bin")
param "file_cru_misc" (str "c:/cru/cru_1901_2006misc.bin")

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
param "file_ndep"     (str "c:/ndep/GlobalNitrogenDeposition.bin")


param "file_temp"     (str "/data/AMJ/tas_AMJ-1-NEUR-44_ICHEC-EC-EARTH_historical_r12i1p1_SMHI-RCA4_v1_day_19510101-20051231.nc")
param "variable_temp" (str "tas")

param "file_prec"       (str "/data/AMJ/pr_AMJ-1-NEUR-44_ICHEC-EC-EARTH_historical_r12i1p1_SMHI-RCA4_v1_day_19510101-20051231.nc")
param "variable_prec" (str "pr")

param "file_insol"      (str "/data/AMJ/rsds_AMJ-1-NEUR-44_ICHEC-EC-EARTH_historical_r12i1p1_SMHI-RCA4_v1_day_19510101-20051231.nc")
param "variable_insol"  (str "rsds")
