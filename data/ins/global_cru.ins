!
! Instruction file with global PFTs to be used with the 
! CRU I/O module.
!

import "global.ins"

!///////////////////////////////////////////////////////////////////////////////////////
! Forcing Data & gridlists
!

param "file_gridlist" (str "gridlist.txt")

param "file_co2"      (str "/scratch/lars/CRUNCEP7/co2_1901-2006.txt") 
param "file_cru"      (str "/scratch/lars/CRUNCEP7/cru/cru_1901_2006.bin")  
param "file_cru_misc" (str "/scratch/lars/CRUNCEP7/cru_1901_2006misc.bin")      

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
param "file_ndep"     (str "/data/ndep/GlobalNitrogenDeposition.bin")

! SIMFIRE-BLAZE related files  
param "file_simfire"  (str "/scratch/lars/FAST_ARCHIVES/SimfireInput.bin")                                            

! Soil map
param "file_soildata" (str "/data/soil/WISE/soilmap_center_interpolated.dat")
!param "file_soildata" (str "../env/soils_lpj.dat")
