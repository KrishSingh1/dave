pft "BNS" (

	! Boreal needleleaved summergreen tree

	include 1
	tree
	needleleaved
	shade_intolerant
	summergreen
	boreal
	tcmin_surv -1000  ! no limit
	tcmin_est -1000   ! no limit
	tcmax_est -2
	twmin_est -1000   ! no limit
	twminusc 43       ! AA from TH 03-11 added this
	gdd5min_est 500
	longevity 300
	fireresist 0.3
	eps_iso 8.0
	seas_iso 1
	eps_mon 4.8
	storfrac_mon 0.5
)

