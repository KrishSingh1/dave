!///////////////////////////////////////////////////////////////////////////////////////
!// LPJ-GUESS INSTRUCTION SCRIPT FOR COHORT/INDIVIDUAL MODE
!// European PFTs
!//
!// Ben Smith, 2003-09-26

!///////////////////////////////////////////////////////////////////////////////////////
!// NOTES
!// 1. Species longevities assume survival of 0.1% to given age; use value of 2 for
!//    shape parameter for background mortality

! Atmospheric CO2 content (ppmv)
! (used only by guessio.cpp)
	param "co2" (num 340)

! Path to CRU data set
! (used only by guessio_cru.cpp)
	param "file_cru" (str "cru_1901-1998.bin")

! Path to CO2 file
! (used only by guessio_cru.cpp)
	param "file_co2" (str "co2_1901-1998.txt")

! Path to file containing list of 0.5 x 0.5 degree grid cells to simulate
! You may need to specify the full pathname (including directory) here
! NB: FILE NAME ONLY (no directory part) for parallel runs on Simba or Lunarc
	param "file_gridlist" (str "gridlist_geb.txt")

! Paths to Cramer & Leemans (unpublished) climate data files
! You may need to specify the full pathname (including directory) here
	param "file_temp" (str "tmp30_21.grd")  !temperature
	param "file_prec" (str "prc30_21.grd")  !precipitation
	param "file_sun" (str "clo30_21.grd")   !sunshine

! Patch to LPJ soil code file
! You may need to specify the full pathname (including directory) here
	param "file_soil" (str "soils_lpj.dat")

! Output file names
! NB: FILE NAME ONLY (no directory part) for parallel runs on Simba or Lunarc
	param "file_cmass" (str "cmass.out")
	param "file_anpp" (str "anpp.out")
	param "file_lai" (str "lai.out")
	param "file_flux" (str "flux.out")

! Whether annual output desired (1) or not (0)
	param "annual_output" (num 1)

! Settings recognised by Plib
! Run GUESS with -help option for list of keywords and their meanings

title 'Demo for cohort mode'

vegmode "cohort"      ! "cohort", "individual" or "population"
nyear 1000            ! number of years to run simulation for
ifdailynpp 0          ! whether to calculate NPP daily (1) or monthly (0)
ifdailydecomp 0       ! whether to calculate soil respiration daily (1) or monthly (0)
ifcalcsla 1           ! whether to calculate SLA from leaf longevity
                      ! (PFT-specific value can be specified in this file instead)
iffire 0              ! whether to implement fire (1) or not (0)
npatch 30             ! number of replicate patches to simulate
patcharea 1000        ! patch area (m2)
estinterval 5         ! years between establishment events in cohort mode
ifdisturb 1           ! whether generic patch-destroying disturbances enabled
distinterval 100      ! average return time for generic patch-destroying disturbances
ifbgestab 1           ! whether background establishment enabled
ifsme 1               ! whether spatial mass effect enabled
ifstochestab 1        ! whether establishment stochastic
ifstochmort 1         ! whether mortality stochastic
ifcdebt 1             ! whether to allow vegetation C storage (1) or not (0)


!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR PFTS
!// Run GUESS with -help option for list of keywords and their meanings

group "common" (

	! Parameters common to all PFTs

	lambda_max 0.8
	emax 5
	reprfrac 0.1
	wscal_min 0.35
)

group "tree" (

	! Parameters common to all trees

	common
	lifeform "tree"
	crownarea_max 27.3
	ltor_max 1
	k_allom2 40
	k_allom3 0.67
	k_rp 1.6
	wooddens 200
	rootdist 0.67 0.33
	cton_leaf 29
	cton_root 29
	cton_sap 330
	pathway "c3"
	respcoeff 1.0
	kest_repr 200
	kest_bg 1 !0.1
	kest_pres 0 !1
	litterme 0.3
	k_chilla 0
	k_chillb 100
	k_chillk 0.05
)

group "grass" (

	! Parameters common to all grasses

	common
	lifeform "grass"
	ltor_max 0.5
	cton_leaf 29
	cton_root 29
	respcoeff 1.0
	litterme 0.2
	parff_min 2500000
	intc 0.01
	fireresist 0.5
)

group "needleleaf" (

	! Parameters common to needleleaved trees

	tree
	gmin 0.3
	k_latosa 3000
	k_allom1 150
	phenology "evergreen"
	leaflong 2
	turnover_leaf 0.5
	turnover_root 0.5
	phengdd5ramp 0
	intc 0.06
	fireresist 0.12
)

group "broadleaf" (

	! Parameters common to broadleaved trees

	tree
	gmin 0.5
	k_allom1 200
	k_latosa 4000
	intc 0.02
)

group "shadetol" (

	! Parameters common to shade-tolerant trees

	turnover_sap 0.05
	greff_min 0.10
	est_max 0.125
	alphar 3.0
	parff_min 1250000
)

group "shadeintol" (

	! Parameters common to light demanding trees

	greff_min 0.12
	turnover_sap 0.1
	est_max 0.25
	alphar 10.0
	parff_min 2500000
)

pft "NE" (

	! Boreal/temperate needleleaved evergreen

	include 1
	needleleaf
	shadetol
	pstemp_min -4
	pstemp_low 10
	pstemp_high 25
	pstemp_max 38
	tcmin_surv -1000
	tcmin_est -1000
	tcmax_est -1.0
	twmin_est -1000
	gdd5min_est 600
	longevity 900
)

pft "TBS" (

	! Temperate shade-tolerant broadleaved summergreen

	include 1
	broadleaf
	shadetol
	phenology "summergreen"
	leaflong 0.5
	turnover_leaf 1
	turnover_root 1
	pstemp_min -2
	pstemp_low 15
	pstemp_high 25
	pstemp_max 38
	tcmin_surv -18
	tcmin_est -18
	tcmax_est 6
	twmin_est -1000
	gdd5min_est 1000
	longevity 430
	phengdd5ramp 200
	fireresist 0.12
)

pft "IBS" (

	! Temperate shade-intolerant broadleaved summergreen

	include 1
	broadleaf
	shadeintol
	phenology "summergreen"
	leaflong 0.5
	turnover_leaf 1
	turnover_root 1
	pstemp_min -4
	pstemp_low 10
	pstemp_high 25
	pstemp_max 38
	tcmin_surv -1000
	tcmin_est -1000
	tcmax_est 1000
	twmin_est -1000
	gdd5min_est 500
	longevity 300
	phengdd5ramp 150
	fireresist 0.12
)

pft "BE" (

	! Temperate broadleaved evergreen

	include 1
	broadleaf
	shadetol
	phenology "evergreen"
	leaflong 2
	turnover_leaf 0.5
	turnover_root 0.5
	pstemp_min -4
	pstemp_low 20
	pstemp_high 30
	pstemp_max 42
	tcmin_surv 3
	tcmin_est 3
	tcmax_est 18.8
	twmin_est -1000
	gdd5min_est 1200
	longevity 400
	fireresist 0.5
)

pft "Grass" (

	! Cool (C3) grass

	include 1
	grass
	pathway "c3"
	rootdist 0.9 0.1
	gmin 0.5
	phenology "any"
	leaflong 1
	turnover_leaf 1
	turnover_root 0.5
	phengdd5ramp 50
	pstemp_min -5
	pstemp_low 10
	pstemp_high 30
	pstemp_max 45
	tcmin_surv -1000
	tcmin_est -1000
	tcmax_est 1000
	twmin_est -1000
	gdd5min_est 0
)
