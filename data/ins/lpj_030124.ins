!///////////////////////////////////////////////////////////////////////////////////////
!// LPJ-GUESS INSTRUCTION SCRIPT FOR POPULATION MODE
!// Demonstration script configuring model as LPJ-DGVM, as described by
!// Sitch et al 2003, Global Change Biology 9: 161-185
!// NB: This script does not include some settings required to run LPJ-GUESS in cohort
!//     or individual mode

! Atmospheric CO2 content (ppmv)
! (used only by guessio.cpp)
	param "co2" (num 340)

! Path to CRU data set
! (used only by guessio_cru.cpp)
	param "file_cru" (str "cru_1901-1998.bin")

! Path to CO2 file
! (used only by guessio_cru.cpp)
	param "file_co2" (str "co2_1901-1998.txt")

! Path to file containing list of 0.5 x 0.5 degree grid cells to simulate
! You may need to specify the full pathname (including directory) here
! NB: FILE NAME ONLY (no directory part) for parallel runs on Simba or Lunarc
	param "file_gridlist" (str "gridlist_global.txt")

! Paths to Cramer & Leemans (unpublished) climate data files
! You may need to specify the full pathname (including directory) here
	param "file_temp" (str "tmp30_21.grd")  !temperature
	param "file_prec" (str "prc30_21.grd")  !precipitation
	param "file_sun" (str "clo30_21.grd")   !sunshine

! Patch to LPJ soil code file
! You may need to specify the full pathname (including directory) here
	param "file_soil" (str "soils_lpj.dat")

! Whether annual output desired (1) or not (0)
	param "annual_output" (num 1)

! Output file names
! NB: FILE NAME ONLY (no directory part) for parallel runs on Simba or Lunarc
	param "file_cmass" (str "cmass.out")
	param "file_anpp" (str "anpp.out")
	param "file_lai" (str "lai.out")
	param "file_flux" (str "flux.out")

! Settings recognised by Plib
! Run GUESS with -help option for list of keywords and their meanings

title 'Demo for population mode'
vegmode "population"  ! "population" = LPJ-DGVM mode
nyear 1000            ! number of years to run simulation for
ifdailynpp 0          ! whether to calculate NPP daily (1) or monthly (0)
ifdailydecomp 0       ! whether to calculate soil respiration daily (1) or monthly (0)
ifcalcsla 1           ! whether to calculate SLA from leaf longevity
                      ! (PFT-specific value can be specified in this file instead)
iffire 1              ! whether to implement fire (1) or not (0)
ifcdebt 1             ! whether to allow vegetation C storage (1) or not (0)


!///////////////////////////////////////////////////////////////////////////////////////
!// PARAMETERS FOR LPJ-DGVM STANDARD PFTS
!// Values as given by Sitch et al 2003, Global Change Biology 9: 161-185 and
!// Thonicke et al 2001, Global Ecology and Biogeography 10: 661-677
!// except where otherwise indicated.
!// Run GUESS with -help option for list of keywords and their meanings

group "common" (

	! Parameters common to all PFTs

	lambda_max 0.8
	reprfrac 0.1
	cton_leaf 29
	cton_root 29
	cton_sap 330
)

group "tree" (

	! Parameters common to all trees

	common
	lifeform "tree"
	crownarea_max 15.0
	ltor_max 1
	k_allom1 100
	k_allom2 40
	k_allom3 0.67  !Sitch et al give 0.5
	k_rp 1.6
	k_latosa 4000  !Sitch et al give 8000
	wooddens 200
	turnover_sap 0.05
	pathway "c3"
	litterme 0.3
)

group "grass" (

	! Parameters common to all grasses

	common
	lifeform "grass"
	rootdist 0.8 0.2  !Sitch et al give 0.9 0.1
	ltor_max 0.75
	phenology "any"
	turnover_leaf 1
	turnover_root 0.5
	leaflong 0.5
	phengdd5ramp 100
	litterme 0.2
)

pft "TrBE" (

	! Tropical broadleaved evergreen

	include 1
	tree
	rootdist 0.85 0.15
	wscal_min 0
	gmin 0.5
	emax 7.0   !Modification D Gerten to increase tropical AET
	respcoeff 0.2
	phenology "evergreen"
	turnover_leaf 0.5
	turnover_root 0.5
	leaflong 2
	phengdd5ramp 0
	pstemp_min 2
	pstemp_low 25
	pstemp_high 30
	pstemp_max 55
	fireresist 0.12
	tcmin_surv 15.5
	tcmin_est 15.5
	tcmax_est 1000
	twmin_est -1000
	gdd5min_est 0
	k_chilla 0
	k_chillb 0
	k_chillk 0
	intc 0.02
)

pft "TrBR" (

	! Tropical broadleaved raingreen

