#!/usr/bin/env bash
set -euo pipefail

# Detect GNU sed (supports --version and prints "GNU").
is_gnu_sed() {
    sed --version 2>/dev/null | grep -qi 'gnu'
}

# In-place sed wrapper that handles BSD vs GNU.
sedi() {
    if is_gnu_sed; then
        # GNU sed: -i requires no extra empty argument.
        sed -i "$@"
    else
        # BSD sed: -i requires an explicit (possibly empty) extension.
        sed -i '' "$@"
    fi
}

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <input-file>"
    exit 1
fi

IN_FILE="${1}"
OUT_FILE="${1/.docx/.md}"

pandoc --from docx --to markdown "${IN_FILE}" -o "${OUT_FILE}"

# Replace `$$    \(3\)` with ` \tag{3} $$` in place.
RX_SEARCH='\$\$[[:space:]]+\\\(([0-9]+)\\\)'
sedi -E "s/${RX_SEARCH}/ \\\\tag{\1} \$\$/g" "${OUT_FILE}"


