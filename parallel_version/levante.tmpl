#!/bin/bash
#
# submit.sh
#
# Portable bash script to run LPJ-GUESS version:
# BINARY
# as a parallel job using SLURM on DKRZ's HPC cluster Levante.
# Based on lunarc.tmpl.
#
# Created automatically on DATE
#
# The following instructions are intended for the file 
# submit.sh, which is generated by make from the file levante.tmpl.
# Do not use levante.tmpl as submit script. Use submit.sh.
#
# Usage:
#   1. Copy script to the directory where you want output written.
#      This will be called the RUN DIRECTORY.
#   2. In an editor, set appropriate values for the variables NPROCESS,
#      INSFILE, GRIDLIST and OUTFILES (NB: no space after the = sign):

NTASKSPERNODE=128          # Should be 128 for the compute partion (where nodes are used exclusively), but should be reduced to match NPROCESS when running on shared (for example the site-based benchmarks)
NPROCESS=256               # NB: Should be multiple of 128 on Levante!  Here choose 256 because it is enough to get a global 15 patch PNV run in the 8 hour maximum wall time limit.
WALLTIME=8:00:00           # NB: 8 hours is the maiximum wall time on Levante
WALLTIME_APPEND=02:00:00   # Does not need to be as long as guess walltime
PARTITION=compute          # NB: Generaly should be "compute" - but could explore "shared" for smaller jobs/benchmarks 
INSFILE=guess.ins
INPUT_MODULE=cf
GRIDLIST=gridlist.txt
OUTFILES='*.out'

#      Where:
#      NPROCESS     = number of processes in parallel job
#      WALLTIME     = maximum wall (real) time for job hh:mm:ss
#      INSFILE      = path to ins file from run directory
#      INPUT_MODULE = input module to use
#      GRIDLIST     = path to gridlist file from run directory
#      OUTFILES     = list of LPJ-GUESS output files in single quotes,
#                     and separated by spaces (filenames only, including
#                     extension, no directory.) Shell wildcards are allowed.
#
#   3. Optionally specify an compute account nmumber (i.e. a code) by
#      exporting the following variable to the environment.
#      On your command line or in your .bashrc, do:
#        export COMPUTEACCOUNT=<compute account nmumber>
#      An account number is necessary on Levante's systems 
#
#
#
#   4. Run the script using the command:
#        ./submit.sh
#      or:
#        ./submit.sh [-n <name>] [-s <file>] [-i <ins-file>]
#
#      All arguments are optional and interpreted as:
#      name     = the name of the job (shown in PBS queue)
#      file     = filename of a file which can override the variables
#                 above
#      ins-file = instruction file to use, overrides the INSFILE
#                 variable above
#
# Nothing to change past here
########################################################################

# Exit if any command fails
set -e

# Handle the command line arguments
while getopts ":n:s:i:" opt; do
    case $opt in
	n ) name=$OPTARG ;;
	s ) submit_vars_file=$OPTARG ;;
	i ) ins=$OPTARG ;;
    esac
done

# Override the submit variables with the contents of a file, if given
if [ -n "$submit_vars_file" ]; then
    source $submit_vars_file
fi

# Override INSFILE with the ins-file parameter, if given
if [ -n "$ins" ]; then
    INSFILE=$ins
fi

# Read the compute account number from the environment, if available.
if [ -n "$COMPUTEACCOUNT" ]; then
    SBATCH_COMPUTEACCOUNT="#SBATCH -A $COMPUTEACCOUNT"
fi

# If running on a shared node, keep hypethreading enable or the job will crash
HYPERTHREADING_HINT="--hint=nomultithread"
if [[ "$PARTITION" == "shared" ]]; then
    HYPERTHREADING_HINT=""
fi


# On Levante, nodes in the compute partition are exclusiv. Since each node has 128 cores, we
# should set NPROCESS to a multiple of 128 to avoid waste.
# This does note apply to the shared partition which we typically use for the smaller benchmarks
# and post-processing.
CORES_PER_NODE=128
if [[ $((NPROCESS%CORES_PER_NODE)) != 0 && "$PARTITION" == "compute" ]]; then
    echo "Please set NPROCESS to a multiple of 128 on when running on the compute nodes (which are used exclusively) on Levante!" >&2
fi

# Convert INSFILE to an absolute path since we will be starting the
# guess instances from different directories.
# Please note when porting this script: readlink may not be available
# on non-Linux systems. Also, using absolute path names means the
# instruction file needs to be in a place accessible from the nodes.
INSFILE=$(readlink -f "$INSFILE")

GRIDLIST_FILENAME=$(basename $GRIDLIST)

# MATTHEW FORREST 08/03/2012 CHANGE!
# This is a modified version of split_gridlist which 'deals' the gridcells out like a deck of cards.
# This has two advantages, no gridlists are left empty and the low productivity (high latitude) and 
# high productivity (low latitude) gridcells are shared out evenly into each sub-gridlist, meaning that each sub-run 
# will take approximately the same length of time. Also is is just much cleaner and tidier
# The downside is that the when the output is appended together again at the end, the gridcells
# won't be in the same order as they were originally.  This might mess up some people's post processing and analysis routines

function split_gridlist {
    # Create empty gridlists first to make sure each run gets one
    for ((a=1; a <= NPROCESS ; a++)) 
    do
      touch run$a/$GRIDLIST_FILENAME
    done

    local process_counter=1
    while read gridcell ; do
	echo $gridcell >> run$process_counter/$GRIDLIST_FILENAME
	((process_counter++))
	if [ $process_counter -gt $NPROCESS ]; then
	    process_counter=1
	fi
    done < $GRIDLIST
}

# Create header of progress.sh script

echo "##############################################################" > progress.sh
echo "# PROGRESS.SH" >> progress.sh
echo "# Upload current guess.log files from local nodes and check" >> progress.sh
echo "# Usage: sh progress.sh" >> progress.sh
echo >> progress.sh

# Create a run subdirectory for each process and clean up

for ((a=1; a <= NPROCESS ; a++))
do
  mkdir -p run$a
  cd run$a ; rm -f guess.log ; rm -f $GRIDLIST_FILENAME ; cd ..
  echo "echo '********** Last few lines of ./run${a}/guess.log: **********'" >> progress.sh
  echo "tail ./run${a}/guess.log" >> progress.sh
done

split_gridlist

# Create SLURM script to request place in queue
cat <<EOF > guess.cmd
#!/bin/bash
#SBATCH -n $NPROCESS
#SBATCH --ntasks-per-node=$NTASKSPERNODE
#SBATCH --time=$WALLTIME
#SBATCH -o "slurm-%j.log"
#SBATCH -e "slurm-%j.err"
#SBATCH --mail-type=ALL
#SBATCH --partition=$PARTITION
$SBATCH_COMPUTEACCOUNT

set -e

# For running module commands
source /sw/etc/profile.levante

# load standard modules for an easy life
module load intel-oneapi-compilers/2022.0.1-gcc-11.2.0
module load hdf/4.2.15-intel-2021.5.0
module load hdf5/1.12.1-intel-2021.5.0
module load netcdf-fortran/4.5.3-intel-2021.5.0
module load netcdf-c/4.8.1-intel-2021.5.0
module load openmpi/4.1.2-intel-2021.5.0


export OMPI_MCA_pml="ucx"
export OMPI_MCA_btl=self
export OMPI_MCA_osc="pt2pt"
export UCX_IB_ADDR_TYPE=ib_global
# for most runs one may or may not want to disable HCOLL
export OMPI_MCA_coll="^ml,hcoll"
export OMPI_MCA_coll_hcoll_enable="0"
export HCOLL_ENABLE_MCAST_ALL="0"
export HCOLL_MAIN_IB=mlx5_0:1
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self
export UCX_UNIFIED_MODE=y
export HDF5_USE_FILE_LOCKING=FALSE
export OMPI_MCA_io="romio321"
export UCX_HANDLE_ERRORS=bt

if ! type -P mpirun &> /dev/null; then
    echo "Didn't find mpirun! Make sure an MPI module is loaded in your" >&2
    echo "login script (~/.bashrc) and recompile LPJ-GUESS with MPI support!" >&2
    exit 1
fi

# If there's a script for setting up files on local disk, run it
if [ -f setup_local.sh ]; then
    srun -n \$SLURM_NNODES -N \$SLURM_NNODES setup_local.sh
fi

# In each run directory, create a symbolic link to the node local storage
for ((a=1; a <= $NPROCESS ; a++))
do
  cd run\$a
  if [ -h local ]; then
      rm local
  fi
  ln -s \$SNIC_TMP local
  cd ..
done

# NOTE: without HT because that doesn't make performance better and results in twice as many open files
#srun -l --wait=0 --cpu_bind=verbose --hint=nomultithread --distribution=block:cyclic BINARY -parallel -input $INPUT_MODULE $INSFILE
srun -l --wait=0 --cpu_bind=verbose $HYPERTHREADING_HINT --distribution=block:cyclic BINARY -parallel -input $INPUT_MODULE $INSFILE



EOF

cat <<EOF > append.cmd
#!/bin/bash
#SBATCH -n 1
#SBATCH --time=$WALLTIME_APPEND
#SBATCH -o "slurm-%j.log"
#SBATCH --partition=shared
$SBATCH_COMPUTEACCOUNT
set -e

function append_files {
    local number_of_jobs=\$1
    local file=\$2

    cp run1/\$file \$file

    local i=""
    for ((i=2; i <= number_of_jobs; i++))
    do
      if [ -f run\$i/\$file ]; then
        cat run\$i/\$file | awk 'NR!=1 || NF==0 || \$1 == \$1+0 { print \$0 }' >> \$file
      fi
    done
}

pushd run1 &> /dev/null
outfiles_unexpanded='$OUTFILES'
outfiles_expanded=\$(echo \$outfiles_unexpanded)
popd &> /dev/null

for file in \$outfiles_expanded
do
  append_files $NPROCESS \$file
done
cat run*/guess.log > guess.log
EOF

# Submit guess job
append_dependency=$(sbatch -J ${name:-"guess"} guess.cmd | awk '{print $NF}')

# Submit append job
[ "$name"!="bm_" ] && name=${name#bm_}
sbatch --dependency=afterok:$append_dependency -J ap_${name:-"guess"} append.cmd | awk '{print $NF}'
