########################################################################
# MAKESCRIPT
# Bash script to produce a portable script to submit and run LPJ-GUESS
# as a parallel job on Lunarc/Docenten
# NB: It will not work on toto7/whenim64
#
# Written by Ben Smith, Lund University, 2005-01-21
#
# usage: sh makescript <guess-exe> <script file>
#
#


echo    '########################################################################' > $2
echo    '# '$2 >> $2
echo    '# Portable bash script to run LPJ-GUESS version:' >> $2
echo    '# '$PWD'/'$1 >> $2
echo    '# as a parallel job on docenten.lunarc (NB: not on toto7/whenim64)' >> $2
echo    '#' >> $2
echo -n '# Created automatically on ' >> $2 ; date >> $2
echo    '# ' >> $2
echo    '# Usage: ' >> $2
echo    '#' >> $2
echo    '#   1. Copy script to the directory where you want output written.' >> $2
echo    '#      This will be called the RUN DIRECTORY.' >> $2
echo    '#   2. In an editor, set appropriate values for the following variables' >> $2
echo    '#      (NB: no space after the = sign):' >> $2
echo >> $2
echo    'NPROCESS=4' >> $2
echo    'WALLTIME=12:00:00' >> $2
echo    'EMAIL=ben.smith@nateko.lu.se' >> $2
echo    'INSFILE=guess.ins' >> $2
echo    'GRIDLIST=gridlist.txt' >> $2
echo    "OUTFILES='cmass.out anpp.out lai.out flux.out'" >> $2
echo >> $2
echo    '#      Where:' >> $2
echo    '#      NPROCESS = number of processes (nodes) in parallel job' >> $2
echo    '#      WALLTIME = maximum wall (real) time for job hh:mm:ss' >> $2
echo    '#      EMAIL    = to which notifications should be sent' >> $2
echo    '#      INSFILE  = path to ins file from run directory' >> $2
echo    '#      GRIDLIST = path to gridlist file from run directory' >> $2
echo    '#      OUTFILES = list of LPJ-GUESS output files in single quotes,' >> $2
echo    '#                 and separated by spaces (filenames only, including' >> $2
echo    '#                 extension, no directory.)' >> $2
echo    '#' >> $2
echo    '#   3. Run the script using the command: sh '$2 >> $2
echo    '#' >> $2
echo    '# Nothing to change past here' >> $2
echo    '########################################################################' >> $2
echo >> $2
echo >> $2
echo    '# Create a run subdirectory for each process and clean up' >> $2
echo >> $2
echo    'for ((a=1; a <= NPROCESS ; a++))' >> $2
echo    'do' >> $2
echo    '  mkdir run$a' >> $2
echo    '  cp $INSFILE run$a' >> $2
echo    '  cd run$a ; rm guess.log ; rm gridlist.txt ; cd ..' >> $2
echo    'done' >> $2
echo >> $2
echo    '# Split gridlist into roughly equal bits, one in each run directory' >> $2
echo    $PWD'/splitgrid $GRIDLIST $NPROCESS' >> $2
echo >> $2
echo    '# Request place in queue' >> $2
echo >> $2
echo    "echo '#/bin/sh' > guess.cmd" >> $2
echo    "echo '#PBS -l nodes='"'$NPROCESS'" >> guess.cmd" >> $2
echo    "echo '#PBS -l walltime='"'$WALLTIME'" >> guess.cmd" >> $2
echo    "echo '#PBS -j oe' >> guess.cmd" >> $2
echo    "echo '#PBS -m ae' >> guess.cmd" >> $2
echo    "echo '#PBS -M '"'$EMAIL'" >> guess.cmd" >> $2
echo >> $2
echo    "echo 'cd "'$PBS_O_WORKDIR'"' >> guess.cmd" >> $2
echo    "echo \"echo '##############################################################' > progress.sh\" >> guess.cmd" >> $2
echo    "echo \"echo '# PROGRESS.SH' >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"echo '# Upload current guess.log files from local nodes and check' >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"echo '# Usage: sh progress.sh' >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"echo >> progress.sh\" >> guess.cmd" >> $2
echo >> $2
echo    '# Move input files to local disks on nodes' >> $2
echo >> $2
echo    "echo 'count=0' >> guess.cmd" >> $2
echo    "echo 'for node in \`cat "'$PBS_NODEFILE'"\`' >> guess.cmd" >> $2
echo    "echo 'do' >> guess.cmd" >> $2
echo    "echo '  count=\`expr "'$count'" + 1\`' >> guess.cmd" >> $2
echo    "echo '  rcp ./run"'${count}'"'/* '"'${node}'":/disk/local' >> guess.cmd" >> $2
echo    "echo \"  echo 'rcp '\"'"'${node}'"'\"':/disk/local/guess.log '\"'"'$PBS_O_WORKDIR'"'\"'/run'\"'"'${count}'"'\" >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"  echo 'echo' >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"  echo \\\"echo '********** Last few lines of ./run'\"'"'${count}'"'\"'/guess.log: **********'\\\" >> progress.sh\" >> guess.cmd" >> $2
echo    "echo \"  echo 'tail '\"'"'$PBS_O_WORKDIR'"'\"'/run'\"'"'${count}'"'\"'/guess.log' >> progress.sh\" >> guess.cmd" >> $2
echo    "echo 'done' >> guess.cmd" >> $2
echo >> $2
echo    '# Run GUESS as a parallel job' >> $2
echo >> $2
echo    "echo 'mpiexec "$PWD"/"$1" '"'$INSFILE'" >> guess.cmd" >> $2
echo >> $2
echo	'# Get output files from local disks on nodes' >> $2
echo >> $2
echo    "echo 'count=0' >> guess.cmd" >> $2
echo    "echo 'for node in \`cat "'$PBS_NODEFILE'"\`' >> guess.cmd" >> $2
echo    "echo 'do' >> guess.cmd" >> $2
echo    "echo '  count=\`expr "'$count'" + 1\`' >> guess.cmd" >> $2
echo    "echo '  rcp "'${node}'":/disk/local/* ./run"'${count}'"' >> guess.cmd" >> $2
echo    "echo 'done' >> guess.cmd" >> $2
echo >> $2
echo    '# Append output files and place in working directory' >> $2
echo >> $2
echo    "echo '"$PWD"/append '"'$NPROCESS'"' '"'$OUTFILES'" >> guess.cmd" >> $2
echo >> $2
echo    '# Submit job' >> $2
echo    'qsub guess.cmd' >> $2
