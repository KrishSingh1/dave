#!/usr/bin/env bash
#
# This script will run the the ozflux site-level simulations in parallel after
# rebuilding the model in release mode. It will also ensure that the specified
# outputs are enabled.
#

set -euo pipefail

# If script is run with DEBUG=1, print commands before running them.
if [ "${DEBUG:-}" = 1 ]
then
	set -x
fi

################################################################################
# User Inputs
################################################################################

# List of site names.
SITES="AdelaideRiver
AliceSpringsMulga
Boyagin
Calperum
CapeTribulation
Collie
CowBay
CumberlandPlain
DalyPasture
DalyUncleared
DryRiver
Emerald
FoggDam
Gingin
GreatWesternWoodlands
HowardSprings
Litchfield
Longreach
Otway
RedDirtMelonFarm
Ridgefield
RiggsCreek
RobsonCreek
Samford
SilverPlains
SturtPlains
TiTreeEast
Tumbarumba
WallabyCreek
Warra
Whroo
WombatStateForest
Yanco"

OUTPUTS="file_dave_gpp
file_dave_resp
file_dave_nee
file_dave_transpiration
file_dave_lai
file_dave_height
file_dave_diameter
file_dave_aboveground_tree_biomass"

################################################################################
# End of User Inputs
################################################################################

# Get directory containing this script.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd -P)"

cd "${DIR}"

# Get number of available processors.
NP=4
if which nproc >/dev/null 2>&1
then
	NP=`nproc`
elif which sysctl >/dev/null 2>&1
then
	# nproc not installed by default on MacOS (usually?), use sysctl instead.
	NP=`sysctl -n hw.logicalcpu`
fi

# Max number of processors to use.
NP_MAX=12
if [ ${NP} -gt ${NP_MAX} ]; then NP=${NP_MAX}; fi

BUILD_PATH=build

# Build the model.
cmake \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_CXX_STANDARD=14 \
	-DCMAKE_CXX_STANDARD_REQUIRED=ON \
	-DCMAKE_CXX_EXTENSIONS=ON \
	-B \
	"${BUILD_PATH}"

cmake --build "${BUILD_PATH}" -j${NP}

# Get paths.
OZFLUX="${DIR}/benchmarks/ozflux"
BIN="${DIR}/${BUILD_PATH}"
GUESS="${BIN}/guess"

# This function will modify the instruction files such that the output file
# (specified by the first argument to this function) is enabled.
enable_output() {
	OUTPUT="${1}"
	INS="${OZFLUX}/outputs.ins"
	if grep "${OUTPUT}" "${INS}" >/dev/null 2>&1
	then
		# BSD sed: MUST use -i ''
		# GNU sed: MUST use just -i (equivalent: -i''); -i '' does NOT work
		I="-i"
		if ! sed --version | /usr/bin/grep -qi gnu >/dev/null 2>&1
		then
			# BSD sed
			I="-i ''"
		fi
		sed ${I} -r -e "s/^([ \t]*)\!([ \t]*${OUTPUT}[ \t].*)/\1\2/g" "${INS}"
	else
		FILE_NAME="${OUTPUT/file_/}.out"
		echo "${OUTPUT} \"${FILE_NAME}\"" >>"${INS}"
	fi
}

# Print a message to stderr and exit with code indicating failure.
die() {
	echo $* >&2
	exit 1
}

# Print a warning message.
warn() {
	echo "WARNING: $*"
}

# Enable required outputs.
for OUTPUT in ${OUTPUTS}
do
	enable_output "${OUTPUT}"
done

# Maximum number of concurrently-running jobs is the minimum of number of CPUs
# and the user-specified NPROCESS parameter.
MAX_NUM_JOBS=${NP}

# Function to sleep until number of background jobs is less than MAX_NUM_JOBS.
wait_for_jobs() {
    while [ $(jobs | wc -l) -ge ${MAX_NUM_JOBS} ]
    do
        sleep 1
    done
}

# Now start all simulations.
for SITE in ${SITES}
do
	SITE_DIR="${OZFLUX}/${SITE}"
	if [ ! -d "${SITE_DIR}" ]
	then
		warn "Site '${SITE}' does not appear to exist. Expected: '${SITE_DIR}'"
	else
		cd "${SITE_DIR}"
		wait_for_jobs
		"${GUESS}" -input nc "${SITE}.ins" &
	fi
done

# Wait for simulations to finish.
wait
